# =============================================================================
# Production Environment Variables
# Copy this file: cp .env.prod.example .env.prod
# Then edit with your actual values
# =============================================================================
# ⚠️ 安全警告：生产环境必须修改所有默认密码和密钥！
# =============================================================================

# --- Required (must change) ---
# ⚠️ 使用强密码生成命令: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=your_secure_mysql_root_password_minimum_24_chars
MYSQL_PASSWORD=your_secure_database_password_minimum_24_chars
JWT_SECRET=your_jwt_secret_minimum_64_characters_random_string_use_openssl_rand_base64_64
MINIO_ROOT_PASSWORD=your_secure_minio_password_minimum_24_chars

# --- Database ---
MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}
MYSQL_DATABASE=homework_ai
MYSQL_USER=homework_ai
MYSQL_PASSWORD=${MYSQL_PASSWORD}

# --- Redis (optional password) ---
REDIS_PASSWORD=

# --- Web ---
WEB_PORT=80
# ⚠️ 生产环境必须配置具体域名，禁止使用 *
CORS_ORIGIN=https://your-domain.com

# --- MinIO ---
# ⚠️ 不要使用默认的 minioadmin
MINIO_ROOT_USER=${MINIO_ROOT_USER:-minioadmin}
MINIO_ROOT_PASSWORD=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET=submissions

# --- AI Grading (configure via admin panel or here) ---
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com

# --- Scaling ---
API_REPLICAS=1
WORKER_REPLICAS=1
WORKER_CONCURRENCY=5

# --- Monitoring (Optional) ---
# ⚠️ 生产环境必须修改 Grafana 默认密码
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_strong_password_min_16_chars
