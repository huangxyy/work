# 仅账号交接模板
# 复制为 deploy/account-only.env，填写后通过安全渠道发送。

# -----------------------------
# MySQL
# -----------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DB_NAME=homework_ai
DB_USER=homework_ai
DB_PASS=CHANGE_ME

# 可选（仅在需要 root 级操作时填写）
MYSQL_ROOT_PASSWORD=

# -----------------------------
# Redis
# -----------------------------
# 如果 Redis 无密码，保持为 redis://host:port
REDIS_URL=redis://127.0.0.1:6379

# -----------------------------
# MinIO
# -----------------------------
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=submissions
