# 运行部署脚本前，先将本文件复制为 deploy/host.env
# 示例：
#   cp deploy/host.env.example deploy/host.env

# 项目路径
APP_DIR=/www/homework-ai
WEB_ROOT=/www/wwwroot/aigzy.cn
DOMAIN=aigzy.cn
API_PORT=3008

# Git 仓库来源
REPO_URL=CHANGE_ME
BRANCH=main

# MySQL 配置
DB_NAME=homework_ai
DB_USER=homework_ai
DB_PASS=CHANGE_ME
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
SKIP_MYSQL_SETUP=0

# 应用安全
JWT_SECRET=CHANGE_ME
CORS_ORIGIN=https://aigzy.cn,http://aigzy.cn

# MinIO
MINIO_DATA=/www/minio-data
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=submissions

# OCR / LLM 配置
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MODEL_CHEAPER=
LLM_MODEL_QUALITY=

# 运行行为
RUN_RETENTION=true

# 更新脚本选项
PNPM_VERSION=8.15.9
RUN_MIGRATIONS=1
USE_SUDO=1
API_SERVICE=homework-ai-api
WORKER_SERVICE=homework-ai-worker
VITE_API_BASE_URL=/api
STRICT_GIT_CLEAN=1
LOCK_FILE=/tmp/homework-ai-deploy.lock

# 备份选项（迁移前）
BACKUP_BEFORE_MIGRATION=1
DB_BACKUP_DIR=/www/homework-ai/backups/db
BACKUP_RETENTION_DAYS=7

# 健康检查选项
CHECK_HEALTH=1
REQUIRE_HEALTHY=0
HEALTH_URL=http://127.0.0.1:3008/api/health
HEALTH_MAX_ATTEMPTS=20
HEALTH_RETRY_INTERVAL=3
