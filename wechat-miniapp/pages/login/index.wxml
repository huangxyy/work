<view class="page theme-login safe-bottom">
  <!-- Hero Section -->
  <view class="login-hero">
    <view class="logo-circle">
      <text class="logo-text">📚</text>
    </view>
    <view class="app-title">Homework AI</view>
    <view class="app-subtitle">智能英语作业批改助手</view>
  </view>

  <!-- Login Card -->
  <view class="login-card">
    <view class="card-title">学生登录</view>

    <!-- API Configuration -->
    <view class="form-section">
      <view class="form-label">API 地址</view>
      <input class="form-input" placeholder="http://127.0.0.1:3000/api" value="{{apiBaseUrl}}" bindinput="handleApiBaseUrlInput" />
      <view class="form-hint">开发工具可用本机地址，真机请填写可访问的 API 地址</view>
      <button class="btn-small-save" bindtap="handleSaveBaseUrl">保存地址</button>
    </view>

    <!-- Login Form -->
    <view class="form-section">
      <view class="form-label">账号</view>
      <input class="form-input" placeholder="请输入账号" value="{{account}}" bindinput="handleAccountInput" />

      <view class="form-label">密码</view>
      <input class="form-input" password placeholder="请输入密码" value="{{password}}" bindinput="handlePasswordInput" />

      <button class="btn-login" loading="{{loading}}" bindtap="handleLogin">
        {{loading ? '登录中...' : '进入小程序'}}
      </button>
    </view>

    <!-- Tips -->
    <view class="login-tips">
      <view class="tip-item">
        <text class="tip-icon">💡</text>
        <text class="tip-text">测试账号: student01</text>
      </view>
      <view class="tip-item">
        <text class="tip-icon">🔑</text>
        <text class="tip-text">测试密码: 123456</text>
      </view>
    </view>
  </view>

  <!-- Footer -->
  <view class="login-footer">
    <view class="footer-text">基于 AI 的英语作业批改系统</view>
  </view>
</view>
