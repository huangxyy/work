@import "../../styles/components.wxss";

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 0 120rpx 0;
}

/* 欢迎区 */
.welcome-hero {
  margin: -32rpx -32rpx 24rpx -32rpx;
  padding: 64rpx 32rpx 48rpx;
  background: var(--gradient-primary);
  border-radius: 0 0 48rpx 48rpx;
  color: #ffffff;
}

.welcome-text {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.welcome-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 筛选区 */
.filter-section {
  margin: 0 24rpx 24rpx;
}

/* 作业列表 */
.homework-list {
  padding: 0 24rpx;
}

.homework-card {
  background: #ffffff;
  border-radius: var(--border-radius-large);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.homework-card:last-child {
  margin-bottom: 0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.homework-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  flex: 1;
  padding-right: 16rpx;
}

.homework-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 12rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.meta-icon {
  margin-right: 6rpx;
  font-size: 24rpx;
}

.meta-text {
  color: var(--text-muted);
}

.homework-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-top: 12rpx;
  margin-bottom: 12rpx;
}

.draft-hint {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #eff6ff;
  border-radius: var(--border-radius-small);
  font-size: 24rpx;
  color: #2563eb;
}

.urgent-hint {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #fef3c7;
  border-radius: var(--border-radius-small);
  font-size: 24rpx;
  color: #d97706;
}

.card-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--border-radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  padding: 0;
}

.action-btn.ghost {
  background: #f5f5f5;
  color: var(--text-secondary);
}

.action-btn.primary {
  background: var(--gradient-primary);
  color: #ffffff;
}

/* 错误状态 */
.error-container {
  padding: 80rpx 32rpx;
  text-align: center;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.error-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.error-text {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
}

/* 加载状态 */
.loading-container {
  padding: 80rpx 0;
  text-align: center;
}

.loading-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 空状态 */
.empty-container {
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
}
