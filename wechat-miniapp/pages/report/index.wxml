<view class="page theme-report safe-bottom">
  <!-- Hero Section -->
  <view class="report-hero">
    <view class="hero-title">学习报告</view>
    <view class="hero-subtitle">{{reportOwnerName}} · {{reportRangeLabel}}</view>
    <view class="hero-sample">样本 {{reportSampleCount}} 份</view>
    <view class="hero-refresh">最近刷新：{{lastUpdatedLabel}}</view>

    <view class="hero-actions">
      <button class="btn-hero-ghost" bindtap="goHomeworks">回到作业</button>
      <button class="btn-hero-ghost" bindtap="goSubmissions">查看提交</button>
    </view>
  </view>

  <!-- Range Selector Card -->
  <view class="rainbow-card">
    <view class="card-header-row">
      <text class="card-title">报告范围</text>
      <button class="btn-export" loading="{{exporting}}" disabled="{{exporting || !reportSampleCount}}" bindtap="exportPdf">导出 PDF</button>
    </view>
    <picker mode="selector" range="{{rangeOptions}}" range-key="label" value="{{rangeIndex}}" bindchange="handleRangeChange">
      <view class="picker-card">
        <text class="picker-label">统计时间</text>
        <view class="picker-value-row">
          <text class="picker-value">{{rangeOptions[rangeIndex].label}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </view>
    </picker>
  </view>

  <!-- Error State -->
  <view wx:if="{{errorText}}" class="error-container">
    <view class="error-icon">!</view>
    <view class="error-title">加载失败</view>
    <view class="error-text">{{errorText}}</view>
    <button class="btn-gradient" bindtap="retryLoad">重新加载</button>
  </view>

  <!-- Loading State -->
  <view wx:elif="{{loading}}" class="loading-container">
    <view class="spinner"></view>
    <view class="loading-text">正在生成学习报告...</view>
  </view>

  <!-- Report Content -->
  <block wx:elif="{{report}}">
    <!-- Empty Report State -->
    <view wx:if="{{isReportEmpty}}" class="empty-state-card">
      <view class="empty-icon">📊</view>
      <view class="empty-title">当前范围还没有可用学习报告</view>
      <view class="empty-text">{{reportEmptyTip}}</view>
      <view class="empty-actions">
        <button class="btn-gradient" bindtap="goHomeworks">去做作业</button>
        <button wx:if="{{canExpandRange}}" class="btn-ghost" bindtap="useWiderRange">扩大时间范围</button>
      </view>
    </view>

    <!-- Summary Cards -->
    <view class="summary-section">
      <view class="section-title">核心概览</view>
      <view class="summary-grid">
        <view wx:for="{{summaryCards}}" wx:key="key" class="summary-card">
          <view class="summary-label">{{item.label}}</view>
          <view class="summary-value">{{item.value}}</view>
        </view>
      </view>
    </view>

    <!-- Score Trend -->
    <view class="section-card">
      <view class="section-title">成绩趋势</view>
      <view wx:if="{{trendList.length}}" class="trend-list">
        <view wx:for="{{trendList}}" wx:for-item="trend" wx:key="date" class="trend-item">
          <view class="trend-header">
            <text class="trend-date">{{trend.date}}</text>
            <text class="trend-count">提交 {{trend.count}}</text>
          </view>
          <view class="trend-score">平均分 {{trend.avg}}</view>
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{trend.avgPercent}}%;"></view>
          </view>
        </view>
      </view>
      <view wx:else class="empty-state-small">
        <view class="empty-text">暂无趋势数据</view>
      </view>
    </view>

    <!-- High Frequency Errors -->
    <view class="section-card">
      <view class="section-title">高频问题</view>
      <view wx:if="{{errorTypes.length}}" class="error-types-list">
        <view wx:for="{{errorTypes}}" wx:key="type" class="error-type-item">
          <view class="error-type-header">
            <text class="error-type-name">{{item.typeLabel}}</text>
            <text class="error-type-ratio">{{item.ratioLabel}}</text>
          </view>
          <view class="error-type-count">出现 {{item.count}} 次</view>
        </view>
      </view>
      <view wx:else class="empty-state-small">
        <view class="empty-text">暂无错误统计</view>
      </view>
    </view>

    <!-- Next Steps -->
    <view class="section-card">
      <view class="section-title">下一步建议</view>
      <view wx:if="{{nextSteps.length}}" class="next-steps-list">
        <view wx:for="{{nextSteps}}" wx:key="text" class="next-step-item">
          <view class="step-number">{{index + 1}}</view>
          <view class="step-text">{{item.text}}</view>
          <view class="step-count">{{item.count}} 次</view>
        </view>
      </view>
      <view wx:else class="empty-state-small">
        <view class="empty-text">暂无学习建议</view>
      </view>
    </view>

    <!-- Class Comparison -->
    <view class="section-card">
      <view class="section-title">班级对比</view>
      <view wx:if="{{comparisonList.length}}" class="comparison-list">
        <view wx:for="{{comparisonList}}" wx:key="classId" class="comparison-item">
          <view class="comparison-classname">{{item.className}}</view>
          <view class="comparison-label">我的均分 {{item.studentAvgValue}} / 班级均分 {{item.classAvgValue}}</view>
          <view class="comparison-bars">
            <view class="comparison-bar">
              <view class="comparison-bar-header">
                <text class="bar-label">我的均分</text>
                <text class="bar-value">{{item.studentAvgValue}}</text>
              </view>
              <progress class="score-progress" percent="{{item.studentAvgPercent}}" stroke-width="12" color="#10b981" border-radius="6" />
            </view>
            <view class="comparison-bar">
              <view class="comparison-bar-header">
                <text class="bar-label">班级均分</text>
                <text class="bar-value">{{item.classAvgValue}}</text>
              </view>
              <progress class="score-progress" percent="{{item.classAvgPercent}}" stroke-width="12" color="#94a3b8" border-radius="6" />
            </view>
          </view>
        </view>
      </view>
      <view wx:else class="empty-state-small">
        <view class="empty-text">暂无班级对比数据</view>
      </view>
    </view>
  </block>
</view>
