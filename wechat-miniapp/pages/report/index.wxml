<view class="container safe-bottom">
  <view class="hero-card">
    <view class="title">学习报告</view>
    <view class="subtitle">{{reportOwnerName}} · {{reportRangeLabel}} · 样本 {{reportSampleCount}} 份</view>
    <view class="helper-text report-hero-text">按时间范围汇总你的成绩趋势、高频问题、下一步建议，以及和班级平均分的对比。</view>
    <view class="helper-text report-refresh-text">最近刷新：{{lastUpdatedLabel}}</view>
    <view class="hero-action-row">
      <button class="ghost-button" bindtap="goHomeworks">回到作业</button>
      <button class="secondary-button" bindtap="goSubmissions">查看提交</button>
    </view>
  </view>

  <view class="card section-gap">
    <view class="row-between">
      <view class="section-title">报告范围</view>
      <button class="ghost-button report-export-button" loading="{{exporting}}" disabled="{{exporting || !reportSampleCount}}" bindtap="exportPdf">导出 PDF</button>
    </view>
    <view class="section-gap">
      <view class="field-label">统计时间</view>
      <picker mode="selector" range="{{rangeOptions}}" range-key="label" value="{{rangeIndex}}" bindchange="handleRangeChange">
        <view class="field-picker">{{rangeOptions[rangeIndex].label}}</view>
      </picker>
    </view>
  </view>

  <view wx:if="{{errorText}}" class="card section-gap">
    <view class="error-state">
      <view class="error-title">加载失败</view>
      <view class="helper-text">{{errorText}}</view>
      <view class="action-row section-gap">
        <button class="secondary-button" bindtap="retryLoad">重新加载</button>
      </view>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="card section-gap">
    <view class="empty-state">
      <view class="empty-title">正在生成学习报告</view>
      <view class="helper-text">请稍候，正在汇总成绩趋势和学习建议。</view>
    </view>
  </view>

  <block wx:elif="{{report}}">
    <view wx:if="{{isReportEmpty}}" class="card section-gap report-empty-card">
      <view class="empty-state">
        <view class="empty-title">当前范围还没有可用学习报告</view>
        <view class="helper-text report-empty-tip">{{reportEmptyTip}}</view>
        <view class="action-row section-gap">
          <button class="secondary-button" bindtap="goHomeworks">去做作业</button>
          <button wx:if="{{canExpandRange}}" class="ghost-button" bindtap="useWiderRange">扩大时间范围</button>
        </view>
      </view>
    </view>

    <view class="card section-gap">
      <view class="section-title">核心概览</view>
      <view class="quick-grid section-gap">
        <view wx:for="{{summaryCards}}" wx:key="key" class="quick-card summary-card">
          <view class="quick-card-title">{{item.label}}</view>
          <view class="summary-value">{{item.value}}</view>
        </view>
      </view>
    </view>

    <view class="card section-gap">
      <view class="section-title">成绩趋势</view>
      <view wx:if="{{trendList.length}}" class="list-stack section-gap">
        <view wx:for="{{trendList}}" wx:key="date" class="quick-card">
          <view class="row-between">
            <view class="quick-card-title">{{item.date}}</view>
            <view class="muted small">提交 {{item.count}}</view>
          </view>
          <view class="helper-text trend-label">平均分 {{item.avg}}</view>
          <progress class="score-bar" percent="{{item.avgPercent}}" stroke-width="8" color="#2563eb" />
        </view>
      </view>
      <view wx:else class="empty-state">
        <view class="empty-title">暂无趋势数据</view>
        <view class="helper-text">当前时间范围内还没有足够的完成数据。</view>
      </view>
    </view>

    <view class="card section-gap">
      <view class="section-title">高频问题</view>
      <view wx:if="{{errorTypes.length}}" class="list-stack section-gap">
        <view wx:for="{{errorTypes}}" wx:key="type" class="quick-card">
          <view class="row-between">
            <view class="quick-card-title">{{item.typeLabel}}</view>
            <view class="muted small">{{item.ratioLabel}}</view>
          </view>
          <view class="helper-text">出现 {{item.count}} 次</view>
        </view>
      </view>
      <view wx:else class="empty-state">
        <view class="empty-title">暂无错误统计</view>
        <view class="helper-text">等有更多批改结果后，这里会显示高频问题。</view>
      </view>
    </view>

    <view class="card section-gap">
      <view class="section-title">下一步建议</view>
      <view wx:if="{{nextSteps.length}}" class="list-stack section-gap">
        <view wx:for="{{nextSteps}}" wx:key="text" class="quick-card">
          <view class="row-between">
            <view class="quick-card-title">{{item.text}}</view>
            <view class="muted small">{{item.count}} 次</view>
          </view>
        </view>
      </view>
      <view wx:else class="empty-state">
        <view class="empty-title">暂无学习建议</view>
        <view class="helper-text">当系统积累到足够样本时，这里会展示更稳定的建议。</view>
      </view>
    </view>

    <view class="card section-gap">
      <view class="section-title">班级对比</view>
      <view wx:if="{{comparisonList.length}}" class="list-stack section-gap">
        <view wx:for="{{comparisonList}}" wx:key="classId" class="quick-card">
          <view class="quick-card-title">{{item.className}}</view>
          <view class="helper-text comparison-label">我的均分 {{item.studentAvgValue}} / 班级均分 {{item.classAvgValue}}</view>
          <view class="comparison-block section-gap-small">
            <view class="row-between">
              <view class="muted tiny">我的均分</view>
              <view class="muted tiny">{{item.studentAvgValue}}</view>
            </view>
            <progress class="score-bar" percent="{{item.studentAvgPercent}}" stroke-width="8" color="#22c55e" />
          </view>
          <view class="comparison-block section-gap-small">
            <view class="row-between">
              <view class="muted tiny">班级均分</view>
              <view class="muted tiny">{{item.classAvgValue}}</view>
            </view>
            <progress class="score-bar" percent="{{item.classAvgPercent}}" stroke-width="8" color="#94a3b8" />
          </view>
        </view>
      </view>
      <view wx:else class="empty-state">
        <view class="empty-title">暂无班级对比数据</view>
        <view class="helper-text">当班级和个人都有足够提交后，这里会展示对比结果。</view>
      </view>
    </view>
  </block>
</view>
