<view class="page theme-homeworks safe-bottom">
  <!-- Loading State -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="spinner"></view>
    <view class="loading-text">正在加载作业详情</view>
  </view>

  <!-- Error State -->
  <view wx:elif="{{errorText}}" class="error-container">
    <view class="error-icon">!</view>
    <view class="error-title">加载失败</view>
    <view class="error-text">{{errorText}}</view>
    <button class="btn-gradient" bindtap="retryLoad">重新加载</button>
  </view>

  <!-- Homework Detail Content -->
  <block wx:elif="{{homework}}">
    <!-- Hero Card -->
    <view class="homework-hero fade-in">
      <view class="homework-hero-title">{{homework.title}}</view>
      <view class="homework-hero-meta">
        <text class="meta-item">班级: {{homework.class.name}}</text>
        <text class="meta-divider">·</text>
        <text class="meta-item">截止: {{dueLabel}}</text>
      </view>
      <view class="status-tag status-{{status.className}}">{{status.label}}</view>
    </view>

    <!-- Description Card -->
    <view class="rainbow-card fade-in">
      <view class="card-section-title">作业说明</view>
      <view class="card-text">{{homework.desc || '暂未提供作业说明'}}</view>
    </view>

    <!-- Draft Notice -->
    <view wx:if="{{hasDraft}}" class="notice-card scale-in">
      <view class="notice-icon">💾</view>
      <view class="notice-text">已保存未提交草稿，重新进入提交页会自动恢复</view>
    </view>

    <!-- Latest Submission Card -->
    <view wx:if="{{latestSubmission}}" class="rainbow-card fade-in">
      <view class="card-section-title">最近提交</view>
      <view class="submission-meta">
        <view class="meta-row">
          <text class="meta-label">状态:</text>
          <view class="status-tag-small status-{{latestSubmission.statusMeta.className}}">{{latestSubmission.statusMeta.label}}</view>
        </view>
        <view class="meta-row">
          <text class="meta-label">时间:</text>
          <text class="meta-value">{{latestSubmission.updatedLabel}}</text>
        </view>
        <view class="meta-row">
          <text class="meta-label">分数:</text>
          <text class="meta-value score">{{latestSubmission.scoreLabel}}</text>
        </view>
      </view>
    </view>

    <!-- Action Buttons -->
    <view class="action-buttons">
      <button class="btn-gradient {{canSubmit ? '' : 'btn-disabled'}}" disabled="{{!canSubmit}}" bindtap="goSubmit">
        {{canSubmit ? (hasDraft ? '继续提交' : '提交作业') : '已截止'}}
      </button>
      <view wx:if="{{latestSubmission}}" class="btn-secondary-row">
        <button class="btn-ghost" bindtap="goLatestResult">最近结果</button>
        <button class="btn-ghost" bindtap="goReport">学习报告</button>
      </view>
      <view wx:else class="btn-secondary-row">
        <button class="btn-ghost" bindtap="goReport">学习报告</button>
      </view>
    </view>

    <!-- Submission History -->
    <view class="section-title-row">
      <text class="section-title">提交记录</text>
      <text class="section-link" bindtap="goAllSubmissions">查看全部 →</text>
    </view>

    <view wx:if="{{history.length}}" class="history-list">
      <view wx:for="{{history}}" wx:key="id" class="history-item" bindtap="goResult" data-id="{{item.id}}">
        <view class="history-header">
          <view class="history-title">{{item.homeworkTitle}}</view>
          <view class="status-tag-small status-{{item.statusMeta.className}}">{{item.statusMeta.label}}</view>
        </view>
        <view class="history-meta">
          <text class="meta-text">{{item.updatedLabel}}</text>
          <text class="meta-text" wx:if="{{item.totalScore !== null && item.totalScore !== undefined}}">分数: {{item.totalScore}}</text>
        </view>
      </view>
    </view>

    <view wx:else class="empty-state-small">
      <view class="empty-icon">📝</view>
      <view class="empty-text">还没有提交记录</view>
    </view>
  </block>
</view>
