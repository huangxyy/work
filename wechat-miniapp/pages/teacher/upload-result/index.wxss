@import "../../../styles/teacher.wxss";

/* 跳过列表 */
.skip-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.skip-item {
  background: #fef2f2;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  border-left: 6rpx solid #ef4444;
}

.skip-file {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  word-break: break-all;
  font-family: monospace;
}

.skip-reason {
  display: block;
  font-size: 24rpx;
  color: #dc2626;
}

/* 提交列表 */
.submission-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 操作区 */
.actions-section {
  padding: 24rpx 16rpx;
}

.full-width {
  width: 100%;
  margin-bottom: 16rpx;
}
