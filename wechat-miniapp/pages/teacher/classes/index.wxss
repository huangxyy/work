@import "../../../styles/components.wxss";

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 0 120rpx 0;
}

.hero {
  margin: 0 0 24rpx 0;
  padding: 64rpx 32rpx 48rpx;
  background: var(--gradient-primary);
  border-radius: 0 0 48rpx 48rpx;
  color: #ffffff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.filter-section {
  margin: 0 24rpx 24rpx;
}

.filter-chips {
  display: flex;
  white-space: nowrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: #ffffff;
  border-radius: var(--border-radius-pill);
  font-size: 26rpx;
  color: var(--text-secondary);
  box-shadow: var(--shadow-soft);
  flex-shrink: 0;
}

.filter-chip.active {
  background: var(--gradient-primary);
  color: #ffffff;
}

.content-area {
  padding: 0 24rpx;
}

.info-card {
  background: #ffffff;
  border-radius: var(--border-radius-large);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.action-cards {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-card {
  flex: 1;
  background: var(--gradient-primary);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  color: #ffffff;
  position: relative;
  box-shadow: var(--shadow-card);
}

.action-card.green {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.action-icon {
  display: block;
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.action-label {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
}

.action-arrow {
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 36rpx;
  opacity: 0.7;
}

.student-section {
  background: #ffffff;
  border-radius: var(--border-radius-large);
  padding: 24rpx;
  box-shadow: var(--shadow-card);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-count {
  font-size: 24rpx;
  color: var(--text-muted);
}

.student-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.student-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.student-item:last-child {
  border-bottom: none;
}

.student-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.student-info {
  flex: 1;
  min-width: 0;
}

.student-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.student-account {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
}

.student-arrow {
  font-size: 36rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

.loading-container {
  padding: 80rpx 0;
  text-align: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

.empty-container {
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-muted);
}
