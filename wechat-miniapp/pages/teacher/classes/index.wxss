@import "../../../styles/components.wxss";

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 24rpx;
}

/* 班级选择器 */
.class-selector-section {
  margin-bottom: 24rpx;
}

.section-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.class-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border-radius: var(--border-radius-medium);
  padding: 24rpx 32rpx;
  box-shadow: var(--shadow-soft);
}

.class-picker.empty {
  opacity: 0.6;
}

.picker-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.picker-arrow {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* 详情区域 */
.detail-section {
  padding-bottom: 40rpx;
}

/* 班级信息卡片 */
.rainbow-card {
  background: #ffffff;
  border-radius: var(--border-radius-large);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.detail-row:not(:last-child) {
  border-bottom: 1rpx solid #f5f5f5;
}

.label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.value.highlight {
  color: var(--primary-purple);
  font-weight: 700;
  font-size: 32rpx;
}

/* 快捷操作 */
.action-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-item {
  flex: 1;
  background: #ffffff;
  border-radius: var(--border-radius-medium);
  padding: 32rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-soft);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 学生列表区域 */
.student-section {
  background: #ffffff;
  border-radius: var(--border-radius-large);
  padding: 24rpx;
  box-shadow: var(--shadow-card);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.section-count {
  font-size: 24rpx;
  color: var(--text-muted);
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: var(--border-radius-pill);
}

/* 学生列表 */
.student-list {
  margin-top: 8rpx;
}

.student-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: var(--border-radius-small);
  margin-bottom: 8rpx;
  background: #f9fafb;
  transition: background 0.2s;
}

.student-item:last-child {
  margin-bottom: 0;
}

.student-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.student-info {
  flex: 1;
}

.student-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.student-account {
  font-size: 24rpx;
  color: var(--text-muted);
}

.student-arrow {
  font-size: 40rpx;
  color: #d1d5db;
  font-weight: 300;
}

/* 空状态 */
.empty-students {
  padding: 60rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

.empty-container {
  padding: 120rpx 32rpx;
  text-align: center;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

/* 加载状态 */
.loading-container {
  padding: 120rpx 0;
  text-align: center;
}

.loading-text {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

.loading-mini {
  padding: 40rpx;
  text-align: center;
}

.spinner-small {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid var(--primary-purple);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
