<wxs module="utils" src="../../../lib/utils.wxs"></wxs>

<view class="page theme-teacher-classes safe-bottom">
  <view class="hero fade-in">
    <view class="hero-title">班级管理</view>
    <view class="hero-subtitle">管理班级信息和学生</view>
  </view>

  <view class="filter-section scale-in">
    <scroll-view class="filter-chips" scroll-x enable-flex>
      <view
        class="filter-chip {{selectedClassId === item.id ? 'active' : ''}}"
        wx:for="{{classes}}"
        wx:key="id"
        bindtap="onClassSelect"
        data-id="{{item.id}}"
      >
        {{item.name}}
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="loading-container">
    <view class="spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <view wx:elif="{{classDetail}}" class="content-area fade-in">
    <view class="info-card">
      <view class="info-header">
        <text class="info-title">班级信息</text>
        <text class="info-action" bindtap="showClassActionSheet">管理</text>
      </view>
      <view class="info-row">
        <text class="info-label">班级名称</text>
        <text class="info-value">{{classDetail.name}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">学生人数</text>
        <text class="info-value">{{studentCount}} 人</text>
      </view>
      <view wx:if="{{classDetail.description}}" class="info-row">
        <text class="info-label">班级描述</text>
        <text class="info-value">{{classDetail.description}}</text>
      </view>
    </view>

    <view class="action-cards">
      <view class="action-card" bindtap="goToClassHomeworks">
        <text class="action-icon">📝</text>
        <text class="action-label">班级作业</text>
        <text class="action-arrow">›</text>
      </view>
      <view class="action-card green" bindtap="goToClassReport">
        <text class="action-icon">📊</text>
        <text class="action-label">学习报告</text>
        <text class="action-arrow">›</text>
      </view>
    </view>

    <view class="student-section">
      <view class="section-header">
        <text class="section-title">学生列表</text>
        <text class="section-count">{{studentCount}} 人</text>
      </view>

      <view wx:if="{{loadingDetail}}" class="loading-container">
        <view class="spinner"></view>
      </view>

      <view wx:else class="student-list">
        <view
          wx:for="{{classDetail.students}}"
          wx:key="id"
          class="student-item"
          bindtap="onStudentTap"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          data-account="{{item.account}}"
        >
          <view class="student-avatar">{{item.name[0]}}</view>
          <view class="student-info">
            <text class="student-name">{{item.name}}</text>
            <text class="student-account">{{item.account}}</text>
          </view>
          <text class="student-arrow">›</text>
        </view>

        <view wx:if="{{!classDetail.students || classDetail.students.length === 0}}" class="empty-container">
          <view class="empty-icon">👥</view>
          <view class="empty-text">暂无学生</view>
          <view class="empty-hint" bindtap="openStudentModal">点击导入学生</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{!loading && classes.length === 0}}" class="empty-container">
    <view class="empty-icon">🏫</view>
    <view class="empty-title">暂无班级</view>
    <view class="empty-text">请联系管理员创建班级</view>
  </view>

  <!-- 导入学生弹窗 -->
  <view wx:if="{{showStudentModal}}" class="modal-overlay" bindtap="closeStudentModal">
    <view class="modal-content" catchtap="true">
      <view class="modal-header">
        <text class="modal-title">导入学生</text>
        <text class="modal-close" bindtap="closeStudentModal">×</text>
      </view>
      <view class="modal-body">
        <view class="modal-hint">每行一个学生，格式：姓名 账号</view>
        <textarea
          class="modal-textarea"
          placeholder="张三 student01&#10;李四 student02"
          value="{{studentInputText}}"
          bindinput="onStudentInputChange"
        ></textarea>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="closeStudentModal">取消</view>
        <view class="modal-btn confirm" bindtap="confirmImportStudents">确认导入</view>
      </view>
    </view>
  </view>
</view>
