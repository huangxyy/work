<wxs module="utils" src="../../../lib/utils.wxs"></wxs>
<scroll-view class="page theme-teacher-classes" scroll-y enhanced show-scrollbar="{{false}}" style="height: 100vh;">
  <view class="hero gradient-purple">
    <view class="hero-title">🏫 班级管理</view>
    <view class="hero-subtitle">管理班级信息和学生</view>
  </view>

  <view class="teacher-filter-section">
    <scroll-view class="teacher-filter-chips" scroll-x enable-flex>
      <view
        class="teacher-filter-chip {{selectedClassId === item.id ? 'active' : ''}}"
        wx:for="{{classes}}"
        wx:key="id"
        bindtap="onClassSelect"
        data-id="{{item.id}}"
      >
        {{item.name}}
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <view wx:elif="{{classDetail}}">
    <view class="section">
      <view class="section-title">班级信息</view>
      <view class="grading-row">
        <text class="grading-label">班级名称</text>
        <text class="grading-value">{{classDetail.name}}</text>
      </view>
      <view class="grading-row">
        <text class="grading-label">学生人数</text>
        <text class="grading-value">{{studentCount}} 人</text>
      </view>
      <view wx:if="{{classDetail.description}}" class="grading-row">
        <text class="grading-label">班级描述</text>
        <text class="grading-value">{{classDetail.description}}</text>
      </view>
    </view>

    <view class="stats-row">
      <view class="stat-card stat-card-clickable" bindtap="goToClassHomeworks">
        <text class="stat-value">📝</text>
        <text class="stat-label">班级作业</text>
      </view>
      <view class="stat-card green stat-card-clickable" bindtap="goToClassReport">
        <text class="stat-value">📊</text>
        <text class="stat-label">学习报告</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">学生列表 ({{studentCount}})</view>

      <view wx:if="{{loadingDetail}}" class="loading">
        <view class="loading-spinner"></view>
      </view>

      <view wx:else>
        <view
          wx:for="{{classDetail.students}}"
          wx:key="id"
          class="submission-card clickable-item"
          bindtap="onStudentTap"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          data-account="{{item.account}}"
        >
          <view class="submission-info">
            <text class="submission-name">{{item.name}}</text>
            <text class="submission-score">{{item.account}}</text>
          </view>
        </view>

        <view wx:if="{{!classDetail.students || classDetail.students.length === 0}}" class="empty">
          <view class="empty-icon">👥</view>
          <view class="empty-text">暂无学生</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{!loading && classes.length === 0}}" class="empty">
    <view class="empty-icon">🏫</view>
    <view class="empty-title">暂无班级</view>
    <view class="empty-text">请联系管理员分配班级</view>
  </view>
</scroll-view>
