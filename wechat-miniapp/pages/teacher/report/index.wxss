@import "../../../styles/components.wxss";

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 0 120rpx 0;
}

.hero {
  margin: 0 0 24rpx 0;
  padding: 64rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  border-radius: 0 0 48rpx 48rpx;
  color: #ffffff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.filter-section {
  margin: 0 24rpx 24rpx;
}

.filter-chips {
  display: flex;
  white-space: nowrap;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: #ffffff;
  border-radius: var(--border-radius-pill);
  font-size: 26rpx;
  color: var(--text-secondary);
  box-shadow: var(--shadow-soft);
  flex-shrink: 0;
}

.filter-chip.active {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  color: #ffffff;
}

.content-area {
  padding: 0 24rpx;
}

.stats-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
  color: #ffffff;
  box-shadow: var(--shadow-card);
}

.stat-card.green {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.stat-card.orange {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  opacity: 0.9;
}

.info-card {
  background: #ffffff;
  border-radius: var(--border-radius-large);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.info-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-muted);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.info-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #fa709a;
}

.trend-list {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 8rpx;
}

.trend-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 16rpx;
  background: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-soft);
}

.trend-item:last-child {
  margin-bottom: 0;
}

.trend-date {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.trend-values {
  text-align: right;
}

.trend-avg,
.trend-count {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.5;
}

.trend-avg {
  color: #fa709a;
  font-weight: 500;
}

.loading-container {
  padding: 80rpx 0;
  text-align: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: #fa709a;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

.empty-container {
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

.student-analysis-card .info-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
}

.toggle-icon {
  font-size: 24rpx;
  color: var(--text-muted);
}

.student-list {
  margin-top: 16rpx;
}

.loading-students {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  gap: 12rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

.spinner.small {
  width: 32rpx;
  height: 32rpx;
  border-width: 4rpx;
}

.empty-students {
  text-align: center;
  padding: 32rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}

.student-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  transition: all 0.2s;
}

.student-item:last-child {
  margin-bottom: 0;
}

.student-item:active {
  background: #f0f4f8;
  transform: scale(0.98);
}

.student-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.student-info {
  flex: 1;
  min-width: 0;
}

.student-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.student-account {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
}

.student-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-btn {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #ffffff;
}

.action-arrow {
  font-size: 28rpx;
  color: #d1d5db;
}

.hint-text {
  text-align: center;
  padding: 24rpx;
  color: var(--text-muted);
  font-size: 26rpx;
}
