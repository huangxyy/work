.report-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.filters {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-item {
  flex: 1;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
}

.stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  color: #ffffff;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.trend-list {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx;
}

.trend-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.trend-item:last-child {
  border-bottom: none;
}

.trend-date {
  font-size: 28rpx;
  color: #333;
}

.trend-values {
  text-align: right;
}

.trend-avg,
.trend-count {
  display: block;
  font-size: 24rpx;
  color: #666;
}
