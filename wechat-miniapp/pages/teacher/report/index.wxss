@import "../../../styles/teacher.wxss";

.trend-list {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 8rpx;
}

.trend-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 16rpx;
  background: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
}

.trend-item:last-child {
  margin-bottom: 0;
}

.trend-date {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.trend-values {
  text-align: right;
}

.trend-avg,
.trend-count {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.5;
}

.trend-avg {
  color: var(--teacher-primary);
  font-weight: 500;
}
