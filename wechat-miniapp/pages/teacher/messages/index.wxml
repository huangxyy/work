<wxs module="utils" src="../../../lib/utils.wxs"></wxs>

<view class="page theme-messages">
  <view class="hero gradient-orange">
    <view class="hero-title">🔔 消息中心</view>
    <view class="hero-subtitle">查看作业通知和系统公告</view>
  </view>

  <view class="teacher-filter-section">
    <scroll-view class="teacher-filter-chips" scroll-x enable-flex>
      <view class="teacher-filter-chip {{activeFilter === 'all' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="all">
        全部
      </view>
      <view class="teacher-filter-chip {{activeFilter === 'unread' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="unread">
        未读 {{unreadCount > 0 ? '(' + unreadCount + ')' : ''}}
      </view>
      <view class="teacher-filter-chip {{activeFilter === 'notification' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="notification">
        通知
      </view>
      <view class="teacher-filter-chip {{activeFilter === 'announcement' ? 'active' : ''}}" bindtap="onFilterChange" data-filter="announcement">
        公告
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{error}}" class="error">
    <text class="error-icon">😕</text>
    <text class="error-title">加载失败</text>
    <text class="error-text">{{error}}</text>
    <view class="btn btn-primary" bindtap="onRetry">重新加载</view>
  </view>

  <view wx:elif="{{filteredMessages.length === 0}}" class="empty">
    <text class="empty-icon">📭</text>
    <text class="empty-title">暂无消息</text>
    <text class="empty-text">{{activeFilter === 'unread' ? '没有未读消息' : '还没有任何消息'}}</text>
  </view>

  <view wx:else class="message-list">
    <view
      wx:for="{{filteredMessages}}"
      wx:key="id"
      class="message-card fade-in"
      style="animation-delay: {{index * 0.05}}s"
      bindtap="onMessageTap"
      data-id="{{item.id}}"
      data-type="{{item.type}}"
    >
      <view class="message-icon-wrapper {{item.type}}">
        <text class="message-icon">{{item.type === 'announcement' ? '📢' : '📝'}}</text>
      </view>

      <view class="message-content">
        <view class="message-header">
          <text class="message-title {{item.read ? '' : 'unread'}}">{{item.title}}</text>
          <view class="status-tag unread" wx:if="{{!item.read}}">未读</view>
        </view>
        <text class="message-desc">{{item.content}}</text>
        <view class="message-meta">
          <text class="message-time">{{utils.formatDateTime(item.createdAt)}}</text>
          <text class="message-source" wx:if="{{item.source}}">{{item.source}}</text>
        </view>
      </view>

      <view class="message-arrow">›</view>
    </view>
  </view>

  <view wx:if="{{hasUnreadMessages}}" class="batch-actions">
    <view class="btn btn-secondary" bindtap="onMarkAllRead">全部已读</view>
  </view>

  <view class="fab-btn" bindtap="onShowCreateModal">
    <text class="fab-icon">+</text>
  </view>

  <view class="modal-mask {{showCreateModal ? 'show' : ''}}" bindtap="onHideCreateModal">
    <view class="modal-content" catchtap>
      <view class="modal-header">
        <text class="modal-title">发布公告</text>
        <text class="modal-close" bindtap="onHideCreateModal">×</text>
      </view>
      <view class="modal-body">
        <view class="form-item">
          <text class="form-label">选择班级</text>
          <picker mode="selector" range="{{classPickerOptions}}" value="{{selectedClassPickerIndex}}" bindchange="onClassChange">
            <view class="form-picker">
              <text>{{classPickerOptions[selectedClassPickerIndex]}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        <view class="form-item">
          <text class="form-label">公告标题 <text class="required">*</text></text>
          <input class="form-input" placeholder="请输入公告标题" value="{{newAnnouncement.title}}" bindinput="onTitleInput" maxlength="100" />
        </view>
        <view class="form-item">
          <text class="form-label">公告内容 <text class="required">*</text></text>
          <textarea class="form-textarea" placeholder="请输入公告内容" value="{{newAnnouncement.content}}" bindinput="onContentInput" maxlength="500" />
        </view>
      </view>
      <view class="modal-footer">
        <view class="btn btn-secondary" bindtap="onHideCreateModal">取消</view>
        <view class="btn btn-primary" bindtap="onCreateAnnouncement">发布</view>
      </view>
    </view>
  </view>
</view>
