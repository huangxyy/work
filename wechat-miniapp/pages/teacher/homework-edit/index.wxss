@import "../../../styles/teacher.wxss";

.page-header {
  background: linear-gradient(135deg, var(--teacher-primary) 0%, var(--teacher-secondary) 100%);
  padding: 48rpx 32rpx 32rpx;
  margin: -32rpx -32rpx 24rpx -32rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.form-section {
  padding: 24rpx;
}

.form-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.form-item:last-child {
  margin-bottom: 0;
}
