<wxs module="utils" src="../../../lib/utils.wxs"></wxs>

<view class="page safe-bottom">
  <view wx:if="{{loading}}" class="loading-container">
    <view class="spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{homework}}" class="content-wrapper">
    <view class="hero fade-in">
      <view class="hero-title">{{homework.title}}</view>
      <view class="hero-subtitle">{{homework.description || '暂无描述'}}</view>
      <view class="hero-stats">
        <view class="hero-stat">
          <text class="hero-stat-value">{{homework.studentCount || 0}}</text>
          <text class="hero-stat-label">学生数</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-value">{{submissions.length}}</text>
          <text class="hero-stat-label">已提交</text>
        </view>
        <view class="hero-stat">
          <text class="hero-stat-value">{{(homework.studentCount || 0) - submissions.length}}</text>
          <text class="hero-stat-label">未提交</text>
        </view>
      </view>
    </view>

    <view class="content-area scale-in">
      <view class="info-card">
        <view class="info-row">
          <text class="info-label">截止时间</text>
          <text class="info-value">{{homework.dueAt ? utils.formatDateTime(homework.dueAt) : '无'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">作业状态</text>
          <view class="status-tag {{homework.status}}">{{homework.status === 'PUBLISHED' ? '已发布' : homework.status === 'DRAFT' ? '草稿' : '已关闭'}}</view>
        </view>
      </view>

      <view class="action-section">
        <button class="action-btn primary" bindtap="onUploadBatch">📸 拍照上传</button>
      </view>

      <view class="submission-section">
        <view class="section-header">
          <text class="section-title">提交列表</text>
          <text class="section-count">{{submissions.length}} 人</text>
        </view>

        <view wx:if="{{submissions.length === 0}}" class="empty-container">
          <text class="empty-icon">📝</text>
          <text class="empty-title">暂无提交记录</text>
          <text class="empty-text">等待学生提交作业</text>
        </view>

        <view wx:else class="submission-list">
          <view
            wx:for="{{submissions}}"
            wx:key="id"
            class="submission-item fade-in"
            style="animation-delay: {{index * 0.05}}s"
            data-id="{{item.id}}"
            bindtap="onViewSubmission"
          >
            <view class="submission-avatar">{{utils.getFirstChar(item.studentName, '?')}}</view>
            <view class="submission-info">
              <text class="submission-name">{{item.studentName}}</text>
              <view class="submission-meta">
                <text wx:if="{{item.totalScore !== null && item.totalScore !== undefined}}" class="submission-score">得分: {{item.totalScore}}</text>
                <text class="submission-time">{{utils.formatDateTime(item.updatedAt)}}</text>
              </view>
            </view>
            <view class="submission-status">
              <view class="status-dot {{item.status}}"></view>
              <text class="status-text">{{utils.getSubmissionStatusText(item.status)}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="error-container">
    <text class="error-icon">😕</text>
    <text class="error-title">加载失败</text>
    <text class="error-text">作业信息不存在或已被删除</text>
    <button class="action-btn primary" bindtap="onRefresh">重新加载</button>
  </view>
</view>
