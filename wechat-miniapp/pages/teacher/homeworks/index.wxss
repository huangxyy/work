@import "../../../styles/teacher.wxss";

.homework-list {
  padding: 0 0 120rpx;
}

.selector-arrow {
  margin-left: 8rpx;
  font-size: 32rpx;
  color: var(--text-muted);
}

.selector-option.active {
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(99, 102, 241, 0.1) 100%);
}

.selector-option.active .selector-option-name {
  color: var(--teacher-primary);
  font-weight: 600;
}

/* 作业卡片 - 明确标识为可点击 */
.homework-card {
  position: relative;
}

.homework-card::after {
  content: '›';
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #d1d5db;
  pointer-events: none;
}

.hero-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.hero-help {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  transition: all 0.2s;
}

.hero-help:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.4);
}

