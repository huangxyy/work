@import "../../../styles/teacher.wxss";

.homework-list {
  padding: 0 0 120rpx;
}

.selector-arrow {
  margin-left: 8rpx;
  font-size: 32rpx;
  color: var(--text-muted);
}

.selector-option.active {
  background: linear-gradient(135deg, rgba(8, 145, 178, 0.1) 0%, rgba(6, 182, 212, 0.1) 100%);
}

.selector-option.active .selector-option-name {
  color: var(--teacher-primary);
  font-weight: 600;
}

/* 作业卡片 - 明确标识为可点击 */
.homework-card {
  position: relative;
}

.homework-card::after {
  content: '›';
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #d1d5db;
  pointer-events: none;
}

.hero-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.hero-help {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  transition: all 0.2s;
}

.hero-help:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.4);
}

.loading-more {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
}

.loading-more .loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #e5e7eb;
  border-top-color: #0891b2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-more .loading-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.no-more {
  text-align: center;
  padding: 32rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-tag.open {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
}

.status-tag.closed {
  background: #e5e7eb;
  color: #6b7280;
}

