@import "../../../styles/components.wxss";

.page {
  min-height: 100vh;
  background: var(--bg-page);
}

.loading-container {
  padding: 80rpx 0;
  text-align: center;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: #7c3aed;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-muted);
}

.error-container {
  padding: 80rpx 32rpx;
  text-align: center;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.error-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.error-text {
  display: block;
  font-size: 26rpx;
  color: var(--text-muted);
}

.content-area {
  padding: 0 24rpx 120rpx;
}

.hero {
  background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
  margin: 0 -24rpx;
  padding: 48rpx 24rpx;
  border-radius: 0 0 48rpx 48rpx;
  margin-bottom: 24rpx;
}

.student-header {
  display: flex;
  align-items: center;
}

.student-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-right: 24rpx;
}

.student-info {
  flex: 1;
}

.student-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.student-account {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.stats-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  color: #ffffff;
}

.stat-card.green {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.stat-card.orange {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

.stat-card.purple {
  background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.stat-label {
  display: block;
  font-size: 20rpx;
  opacity: 0.9;
}

.section-card {
  background: #ffffff;
  border-radius: var(--border-radius-large);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.empty-list {
  text-align: center;
  padding: 48rpx 0;
  color: var(--text-muted);
  font-size: 26rpx;
}

.submission-list {
  margin-top: 8rpx;
}

.submission-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
  transition: all 0.2s;
}

.submission-item:last-child {
  margin-bottom: 0;
}

.submission-item:active {
  background: #f0f4f8;
  transform: scale(0.98);
}

.submission-info {
  flex: 1;
  min-width: 0;
}

.submission-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.submission-time {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
}

.submission-score-wrapper {
  margin: 0 16rpx;
}

.submission-score {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 56rpx;
  height: 56rpx;
  padding: 0 16rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.submission-score.pending {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  font-size: 22rpx;
}

.submission-score.failed {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  font-size: 22rpx;
}

.submission-arrow {
  font-size: 28rpx;
  color: #d1d5db;
}

.fade-in {
  animation: fadeIn 0.3s ease forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
