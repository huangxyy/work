<wxs module="utils" src="../../../lib/utils.wxs"></wxs>

<view class="page theme-student-report safe-bottom">
  <view wx:if="{{loading}}" class="loading-container">
    <view class="spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{!student}}" class="error-container">
    <text class="error-icon">😕</text>
    <text class="error-title">学生不存在</text>
    <text class="error-text">未找到该学生的信息</text>
  </view>

  <view wx:else class="content-area fade-in">
    <view class="hero">
      <view class="student-header">
        <view class="student-avatar">{{utils.getFirstChar(student.name, '学')}}</view>
        <view class="student-info">
          <text class="student-name">{{student.name}}</text>
          <text class="student-account">{{student.account || '无账号'}}</text>
        </view>
      </view>
    </view>

    <view class="stats-row">
      <view class="stat-card">
        <text class="stat-value">{{stats.total}}</text>
        <text class="stat-label">提交次数</text>
      </view>
      <view class="stat-card green">
        <text class="stat-value">{{stats.avgScore}}</text>
        <text class="stat-label">平均分</text>
      </view>
      <view class="stat-card orange">
        <text class="stat-value">{{stats.highScore}}</text>
        <text class="stat-label">最高分</text>
      </view>
      <view class="stat-card purple">
        <text class="stat-value">{{stats.lowScore}}</text>
        <text class="stat-label">最低分</text>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">📋 提交记录</view>
      <view wx:if="{{submissions.length === 0}}" class="empty-list">
        <text>暂无提交记录</text>
      </view>
      <view wx:else class="submission-list">
        <view 
          wx:for="{{submissions}}" 
          wx:key="id" 
          class="submission-item"
          data-id="{{item.id}}"
          bindtap="goSubmissionDetail"
        >
          <view class="submission-info">
            <text class="submission-title">{{item.homework && item.homework.title || '未知作业'}}</text>
            <text class="submission-time">{{utils.formatDateTime(item.createdAt)}}</text>
          </view>
          <view class="submission-score-wrapper">
            <text class="submission-score" wx:if="{{item.totalScore !== null && item.totalScore !== undefined}}">{{item.totalScore}}</text>
            <text class="submission-score pending" wx:elif="{{item.status === 'QUEUED'}}">排队</text>
            <text class="submission-score pending" wx:elif="{{item.status === 'PROCESSING'}}">处理</text>
            <text class="submission-score failed" wx:elif="{{item.status === 'FAILED'}}">失败</text>
            <text class="submission-score pending" wx:else>--</text>
          </view>
          <text class="submission-arrow">›</text>
        </view>
      </view>
    </view>
  </view>
</view>
