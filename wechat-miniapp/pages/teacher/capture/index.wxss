@import "../../../styles/teacher.wxss";

.selector-section {
  padding: 16rpx;
}

.draft-card {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 20rpx;
  margin: 0 16rpx 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

.draft-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.draft-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #92400e;
}

.draft-clear {
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #92400e;
  border: none;
}

.draft-clear::after {
  display: none;
}

.draft-notice {
  font-size: 26rpx;
  color: #78350f;
  margin-bottom: 8rpx;
}

.draft-hint {
  font-size: 22rpx;
  color: #a16207;
  opacity: 0.8;
}

.photo-section {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 0 16rpx 16rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-count {
  font-size: 24rpx;
  color: var(--text-muted);
  background: #f3f4f6;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.actions {
  padding: 32rpx 16rpx;
}

.selector-value.mode-cheap {
  color: var(--teacher-green);
}

.selector-value.mode-quality {
  color: var(--teacher-purple);
}

.hero-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.fade-in {
  animation: fadeIn 0.3s ease forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
