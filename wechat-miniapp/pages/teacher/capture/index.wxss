@import "../../../styles/teacher.wxss";

.selector-section {
  padding: 16rpx;
}

.draft-card {
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 20rpx;
  margin: 0 16rpx 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

.draft-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.draft-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #92400e;
}

.draft-clear {
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #92400e;
  border: none;
}

.draft-clear::after {
  display: none;
}

.draft-notice {
  font-size: 26rpx;
  color: #78350f;
  margin-bottom: 8rpx;
}

.draft-hint {
  font-size: 22rpx;
  color: #a16207;
  opacity: 0.8;
}

.photo-section {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 0 16rpx 16rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.section-count {
  font-size: 24rpx;
  color: var(--text-muted);
  background: #f3f4f6;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.upload-area-empty {
  padding: 48rpx 32rpx;
  text-align: center;
}

.upload-area-empty .upload-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.upload-area-empty .upload-hint {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.upload-area-empty .upload-subhint {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
}

.upload-buttons {
  display: flex;
  gap: 24rpx;
  justify-content: center;
}

.btn-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 200rpx;
  height: 160rpx;
  border-radius: 20rpx;
  border: none;
  padding: 24rpx;
  transition: all 0.3s;
}

.btn-upload::after {
  border: none;
}

.btn-camera {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
  color: #ffffff;
}

.btn-camera:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.btn-album {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
}

.btn-album:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.btn-upload .btn-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.btn-upload .btn-text {
  font-size: 26rpx;
  font-weight: 500;
}

.upload-tip {
  text-align: center;
  color: var(--text-muted);
  font-size: 22rpx;
  margin-top: 16rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  width: calc(33.33% - 12rpx);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  background: #f5f5f5;
}

.photo-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-item .remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  z-index: 10;
}

.photo-add-item {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8f9fa;
  border: 3rpx dashed #ddd;
}

.photo-add-item .add-buttons {
  display: flex;
  gap: 16rpx;
}

.photo-add-item .add-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s;
}

.photo-add-item .add-btn:active {
  transform: scale(0.9);
  background: #f0f0f0;
}

.actions {
  padding: 32rpx 16rpx;
}

.selector-value.mode-cheap {
  color: var(--teacher-green);
}

.selector-value.mode-quality {
  color: var(--teacher-purple);
}

.hero-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.fade-in {
  animation: fadeIn 0.3s ease forwards;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
