<!-- pages/profile/index.wxml -->
<view class="page theme-profile">
  <!-- 用户信息卡片 -->
  <view class="user-hero scale-in">
    <view class="user-avatar">
      <image src="{{user && user.name ? '/assets/default-avatar.png' : '/assets/default-avatar.png'}}" class="avatar-image" />
    </view>
    <view class="user-info">
      <view class="user-name">{{user && user.name ? user.name : '未登录用户'}}</view>
      <view class="user-account">{{user && user.account ? user.account : '--'}} · {{user && user.role ? user.role : '--'}}</view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="menu-section fade-in">
    <view class="section-title">快捷入口</view>
    <view class="menu-item" bindtap="goMessages">
      <view class="menu-icon">通知</view>
      <view class="menu-text">消息中心</view>
      <view wx:if="{{unreadCount > 0}}" class="unread-badge">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="goHomeworks">
      <view class="menu-icon">作业</view>
      <view class="menu-text">我的作业</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="goSubmissions">
      <view class="menu-icon">记录</view>
      <view class="menu-text">提交记录</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="goReport">
      <view class="menu-icon">报告</view>
      <view class="menu-text">学习报告</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <!-- 账号管理 -->
  <view class="menu-section fade-in">
    <view class="section-title">账号管理</view>
    <view class="menu-item" bindtap="toggleProfileCard">
      <view class="menu-icon">👤</view>
      <view class="menu-text">修改资料</view>
      <view class="menu-arrow">{{showProfileCard ? '收起' : '›'}}</view>
    </view>
    <view class="menu-item" bindtap="togglePasswordCard">
      <view class="menu-icon">🔒</view>
      <view class="menu-text">修改密码</view>
      <view class="menu-arrow">{{showPasswordCard ? '收起' : '›'}}</view>
    </view>
  </view>

  <!-- 修改资料展开卡片 -->
  <view wx:if="{{showProfileCard}}" class="expand-card fade-in">
    <view class="form-field">
      <view class="field-label">姓名</view>
      <input class="field-input" value="{{profileName}}" placeholder="请输入姓名" bindinput="onProfileNameInput" />
    </view>
    <view class="form-field">
      <view class="field-label">邮箱</view>
      <input class="field-input" value="{{profileEmail}}" placeholder="选填" bindinput="onProfileEmailInput" />
    </view>
    <view class="form-field">
      <view class="field-label">手机号</view>
      <input class="field-input" value="{{profilePhone}}" placeholder="选填" bindinput="onProfilePhoneInput" />
    </view>
    <button class="btn-gradient" loading="{{updatingProfile}}" bindtap="submitUpdateProfile">保存资料</button>
  </view>

  <!-- 修改密码展开卡片 -->
  <view wx:if="{{showPasswordCard}}" class="expand-card fade-in">
    <view class="form-field">
      <view class="field-label">当前密码</view>
      <input class="field-input" type="password" value="{{oldPassword}}" placeholder="请输入当前密码" bindinput="onOldPasswordInput" />
    </view>
    <view class="form-field">
      <view class="field-label">新密码</view>
      <input class="field-input" type="password" value="{{newPassword}}" placeholder="至少 8 位，包含字母和数字" bindinput="onNewPasswordInput" />
    </view>
    <view class="form-field">
      <view class="field-label">确认新密码</view>
      <input class="field-input" type="password" value="{{confirmPassword}}" placeholder="再次输入新密码" bindinput="onConfirmPasswordInput" />
    </view>
    <button class="btn-gradient" loading="{{changingPassword}}" bindtap="submitChangePassword">确认修改</button>
  </view>

  <!-- 接口配置 -->
  <view class="menu-section fade-in">
    <view class="section-title">接口配置</view>
    <view class="config-content">
      <view class="helper-text">修改 API Base URL 可切换测试/正式环境</view>
      <input class="field-input config-input" value="{{apiBaseUrl}}" placeholder="http://127.0.0.1:3000/api" bindinput="handleApiBaseUrlInput" />
      <view class="action-buttons">
        <button class="btn-secondary" bindtap="saveApiBaseUrl">保存地址</button>
        <button class="btn-secondary" loading="{{syncing}}" bindtap="refreshProfile">同步用户</button>
      </view>
    </view>
  </view>

  <!-- 本地草稿 -->
  <view class="menu-section fade-in">
    <view class="menu-item">
      <view class="menu-icon">📝</view>
      <view class="menu-text">本地草稿</view>
      <view class="draft-count">{{draftCount}}</view>
    </view>
    <view class="draft-actions">
      <button class="btn-secondary small" disabled="{{!draftCount}}" loading="{{clearingDrafts}}" bindtap="clearAllDrafts">清理草稿</button>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
</view>
