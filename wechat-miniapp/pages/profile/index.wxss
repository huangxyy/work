/* pages/profile/index.wxss */
@import "../../styles/components.wxss";

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 32rpx;
}

/* 用户信息 */
.user-hero {
  margin: -32rpx -32rpx 32rpx -32rpx;
  padding: 64rpx 32rpx 48rpx;
  background: var(--gradient-primary);
  border-radius: 0 0 48rpx 48rpx;
  display: flex;
  align-items: center;
  color: #ffffff;
}

.user-avatar {
  margin-right: 24rpx;
}

.avatar-emoji {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.user-account {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 菜单区域 */
.menu-section {
  background: #ffffff;
  border-radius: var(--border-radius-large);
  margin: 0 32rpx 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.section-title {
  padding: 24rpx 32rpx 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  position: relative;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  width: 48rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 40rpx;
  color: var(--text-muted);
  font-weight: 300;
}

/* 徽章 */
.unread-badge {
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 999rpx;
  text-align: center;
  padding: 0 10rpx;
  background: var(--secondary-pink);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 8rpx;
}

.draft-count {
  min-width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  text-align: center;
  background: var(--gradient-primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

/* 展开卡片 */
.expand-card {
  background: #ffffff;
  border-radius: var(--border-radius-large);
  margin: 0 32rpx 24rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.form-field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
}

.field-input {
  min-height: 80rpx;
  width: 100%;
  padding: 20rpx 24rpx;
  border-radius: var(--border-radius-medium);
  background: #f5f5f5;
  border: none;
  font-size: 28rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

.config-input {
  margin-top: 12rpx;
  margin-bottom: 16rpx;
}

/* 配置区域 */
.config-content {
  padding: 0 32rpx 24rpx;
}

.helper-text {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
}

.action-buttons {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

/* 草稿操作 */
.draft-actions {
  padding: 0 32rpx 24rpx;
  display: flex;
  justify-content: flex-end;
}

/* 退出登录 */
.logout-section {
  padding: 32rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #ffffff;
  color: var(--secondary-pink);
  border: 2rpx solid var(--secondary-pink);
  border-radius: var(--border-radius-pill);
  font-size: 28rpx;
  font-weight: 600;
}

.logout-btn::after {
  border: none;
}
