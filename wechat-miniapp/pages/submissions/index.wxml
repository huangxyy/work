<view class="page theme-result safe-bottom">
  <!-- Hero Section -->
  <view class="submissions-hero">
    <view class="hero-title">我的提交记录</view>
    <view class="hero-subtitle">汇总所有提交记录，方便快速查看批改状态和分数</view>

    <!-- KPI Grid -->
    <view class="kpi-grid">
      <view class="kpi-card">
        <view class="kpi-value">{{totalCount}}</view>
        <view class="kpi-label">全部提交</view>
      </view>
      <view class="kpi-card">
        <view class="kpi-value done">{{doneCount}}</view>
        <view class="kpi-label">已完成</view>
      </view>
      <view class="kpi-card">
        <view class="kpi-value processing">{{processingCount}}</view>
        <view class="kpi-label">处理中</view>
      </view>
      <view class="kpi-card">
        <view class="kpi-value failed">{{failedCount}}</view>
        <view class="kpi-label">失败</view>
      </view>
    </view>

    <!-- Summary Cards -->
    <view class="summary-row">
      <view class="summary-mini-card">
        <view class="summary-mini-label">平均分</view>
        <view class="summary-mini-value">{{averageScore}}</view>
      </view>
      <view class="summary-mini-card">
        <view class="summary-mini-label">完成率</view>
        <view class="summary-mini-value">{{completionRate}}</view>
      </view>
    </view>
  </view>

  <!-- Error State -->
  <view wx:if="{{errorText}}" class="error-container">
    <view class="error-icon">!</view>
    <view class="error-title">加载失败</view>
    <view class="error-text">{{errorText}}</view>
    <button class="btn-gradient" bindtap="retryLoad">重新加载</button>
  </view>

  <!-- Loading State -->
  <view wx:elif="{{loading}}" class="loading-container">
    <view class="spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <!-- Content -->
  <block wx:else>
    <!-- Filter Section -->
    <view class="filter-card">
      <view class="filter-header">
        <text class="filter-title">筛选记录</text>
        <text class="filter-reset" bindtap="resetFilters">重置</text>
      </view>

      <!-- Search Input -->
      <view class="filter-item">
        <input class="search-input" placeholder="搜索作业标题" value="{{keyword}}" bindinput="handleKeywordInput" />
      </view>

      <!-- Status Picker -->
      <view class="filter-item">
        <picker mode="selector" range="{{statusOptions}}" range-key="label" value="{{statusIndex}}" bindchange="handleStatusChange">
          <view class="picker-value">
            <text class="{{statusIndex > 0 ? 'picker-selected' : ''}}">{{statusOptions[statusIndex].label}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <!-- Score Range -->
      <view class="score-range-row">
        <view class="score-range-item">
          <text class="range-label">最低分</text>
          <input class="range-input" type="number" placeholder="0" value="{{scoreMin}}" bindinput="handleScoreMinInput" />
        </view>
        <view class="score-range-item">
          <text class="range-label">最高分</text>
          <input class="range-input" type="number" placeholder="100" value="{{scoreMax}}" bindinput="handleScoreMaxInput" />
        </view>
      </view>
    </view>

    <!-- Empty State -->
    <view wx:if="{{filteredList.length === 0}}" class="empty-state">
      <view class="empty-icon">📋</view>
      <view class="empty-title">暂无匹配记录</view>
      <view class="empty-text">下拉刷新或调整筛选条件</view>
    </view>

    <!-- Submission List -->
    <view wx:else class="submission-list">
      <view wx:for="{{filteredList}}" wx:key="id" class="submission-card" bindtap="goResult" data-id="{{item.id}}">
        <view class="card-top">
          <view class="card-title">{{item.homeworkTitle}}</view>
          <view class="status-tag status-{{item.statusMeta.className}}">{{item.statusMeta.label}}</view>
        </view>

        <view class="card-chips">
          <view class="chip">图片 {{item.imageCountLabel}}</view>
          <view class="chip">分数 {{item.scoreLabel}}</view>
        </view>

        <view class="card-meta">
          <text class="meta-text">更新时间: {{item.updatedLabel}}</text>
        </view>

        <view wx:if="{{item.errorText}}" class="card-error">
          <text class="error-icon">⚠</text>
          <text class="error-text">{{item.errorText}}</text>
        </view>

        <view class="card-actions" catchtap="stopPropagation">
          <button class="btn-small-ghost" data-homeworkid="{{item.homeworkId}}" catchtap="goHomeworkDetail">作业详情</button>
          <button class="btn-small-ghost" data-homeworkid="{{item.homeworkId}}" catchtap="goResubmit">再次提交</button>
        </view>
      </view>
    </view>
  </block>
</view>
