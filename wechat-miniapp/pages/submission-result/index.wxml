<view class="page theme-result">
  <!-- Loading State -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="spinner"></view>
    <view class="loading-text">正在同步批改结果</view>
    <view class="loading-hint">如果还在排队或处理中，页面会自动轮询刷新</view>
  </view>

  <!-- Error State -->
  <view wx:elif="{{errorText}}" class="error-state-card">
    <view class="error-icon">!</view>
    <view class="error-title">结果加载失败</view>
    <view class="error-message">{{errorText}}</view>
    <button class="retry-button" bindtap="retryLoad">重新加载</button>
  </view>

  <!-- Result Content -->
  <block wx:else>
    <!-- Processing State -->
    <view wx:if="{{isPolling}}" class="processing-state">
      <view class="spinner"></view>
      <view class="processing-text">正在批改中...</view>
      <view class="processing-hint">{{pollingHint}}</view>
      <button class="refresh-button" bindtap="retryLoad">立即刷新</button>
    </view>

    <!-- Score Hero Section -->
    <view wx:if="{{submission}}" class="score-hero scale-in">
      <view class="score-label">本次得分</view>
      <view class="score-number">{{displayScore}}</view>
      <view class="score-dimensions">
        <view class="dimension-tag">语法: {{dimensionScores?.grammar || '--'}}</view>
        <view class="dimension-tag">词汇: {{dimensionScores?.vocabulary || '--'}}</view>
        <view class="dimension-tag">内容: {{dimensionScores?.content || '--'}}</view>
      </view>
      <view class="score-status status-{{statusMeta?.className || 'default'}}">{{statusMeta?.label || '未知'}}</view>
    </view>

    <!-- Quick Stats -->
    <view wx:if="{{submission}}" class="stats-grid fade-in">
      <view class="stat-item">
        <view class="stat-value">{{errorCount}}</view>
        <view class="stat-label">错误数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{nextStepCount}}</view>
        <view class="stat-label">建议条数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{imageCount}}</view>
        <view class="stat-label">图片数</view>
      </view>
    </view>

    <!-- Action Buttons -->
    <view wx:if="{{submission}}" class="action-row">
      <button class="action-button ghost" bindtap="goHomeworkDetail">作业详情</button>
      <button class="action-button ghost" bindtap="goSubmissions">提交记录</button>
      <button class="action-button primary" bindtap="goReport">学习报告</button>
    </view>

    <!-- Timeline -->
    <view wx:if="{{submission}}" class="result-section fade-in">
      <view class="section-header">
        <text class="section-icon">📋</text>
        <text class="section-title">处理进度</text>
      </view>
      <view class="timeline">
        <view wx:for="{{timeline}}" wx:key="key" class="timeline-item {{item.active ? 'active' : ''}}">
          <view class="timeline-dot"></view>
          <view class="timeline-text">{{item.label}}</view>
        </view>
      </view>
    </view>

    <!-- Failed State -->
    <view wx:if="{{isFailed}}" class="result-section fade-in">
      <view class="section-header">
        <text class="section-icon">❌</text>
        <text class="section-title">处理失败</text>
      </view>
      <view class="error-card">
        <view class="error-card-text">{{submission.errorMsg || submission.errorCode || '这次批改未成功完成，你可以重新提交。'}}</view>
        <button class="retry-button inline" bindtap="goResubmit">重新提交</button>
      </view>
    </view>

    <!-- Grading Summary -->
    <view wx:if="{{grading && grading.summary}}" class="result-section fade-in">
      <view class="section-header">
        <text class="section-icon">📝</text>
        <text class="section-title">批改总结</text>
      </view>
      <view class="summary-card rainbow-card">{{grading.summary}}</view>
    </view>

    <!-- Dimension Scores -->
    <view wx:if="{{grading && dimensionScores}}" class="result-section fade-in">
      <view class="section-header">
        <text class="section-icon">📊</text>
        <text class="section-title">维度得分</text>
      </view>
      <view class="dimension-list">
        <view class="dimension-item">
          <view class="dimension-header">
            <text class="dimension-name">语法</text>
            <text class="dimension-score">{{dimensionScores.grammar || 0}}</text>
          </view>
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{dimensionScores.grammar || 0}}%; background: linear-gradient(90deg, #60a5fa, #3b82f6);"></view>
          </view>
        </view>
        <view class="dimension-item">
          <view class="dimension-header">
            <text class="dimension-name">词汇</text>
            <text class="dimension-score">{{dimensionScores.vocabulary || 0}}</text>
          </view>
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{dimensionScores.vocabulary || 0}}%; background: linear-gradient(90deg, #a78bfa, #8b5cf6);"></view>
          </view>
        </view>
        <view class="dimension-item">
          <view class="dimension-header">
            <text class="dimension-name">结构</text>
            <text class="dimension-score">{{dimensionScores.structure || 0}}</text>
          </view>
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{dimensionScores.structure || 0}}%; background: linear-gradient(90deg, #34d399, #10b981);"></view>
          </view>
        </view>
        <view class="dimension-item">
          <view class="dimension-header">
            <text class="dimension-name">内容</text>
            <text class="dimension-score">{{dimensionScores.content || 0}}</text>
          </view>
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{dimensionScores.content || 0}}%; background: linear-gradient(90deg, #fbbf24, #f59e0b);"></view>
          </view>
        </view>
        <view class="dimension-item">
          <view class="dimension-header">
            <text class="dimension-name">连贯</text>
            <text class="dimension-score">{{dimensionScores.coherence || 0}}</text>
          </view>
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{dimensionScores.coherence || 0}}%; background: linear-gradient(90deg, #f472b6, #ec4899);"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- Suggestions -->
    <view wx:if="{{hasNextSteps}}" class="result-section fade-in">
      <view class="section-header">
        <text class="section-icon">💡</text>
        <text class="section-title">改进建议</text>
      </view>
      <view class="suggestions-card rainbow-card">
        <view class="suggestion-item" wx:for="{{grading.nextSteps}}" wx:key="index">
          <view class="suggestion-index">{{index + 1}}</view>
          <view class="suggestion-text">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- Errors -->
    <view wx:if="{{hasErrors}}" class="result-section fade-in">
      <view class="section-header">
        <text class="section-icon">🔍</text>
        <text class="section-title">错误与修改建议</text>
      </view>
      <view class="errors-list">
        <view class="error-item" wx:for="{{grading.errors}}" wx:key="index">
          <view class="error-chip">{{item.type}}</view>
          <view class="error-message">{{item.message}}</view>
          <view wx:if="{{item.original}}" class="error-original">
            <text class="error-label">原句：</text>{{item.original}}
          </view>
          <view wx:if="{{item.suggestion}}" class="error-suggestion">
            <text class="error-label">建议：</text>{{item.suggestion}}
          </view>
        </view>
      </view>
    </view>

    <!-- Original Images -->
    <view wx:if="{{submission.images && submission.images.length}}" class="result-section fade-in">
      <view class="section-header">
        <text class="section-icon">🖼️</text>
        <text class="section-title">原始图片</text>
      </view>
      <view class="image-grid">
        <image
          wx:for="{{submission.images}}"
          wx:key="id"
          class="preview-image"
          src="{{item.url}}"
          mode="aspectFill"
          data-current="{{item.url}}"
          bindtap="previewImage"
        />
      </view>
    </view>

    <!-- Teacher Feedback -->
    <view wx:if="{{hasTeacherFeedback}}" class="result-section fade-in">
      <view class="section-header">
        <text class="section-icon">👨‍🏫</text>
        <text class="section-title">教师反馈</text>
      </view>
      <view class="feedback-card rainbow-card">
        <view wx:if="{{submission.manualScore !== null && submission.manualScore !== undefined}}" class="feedback-score">
          人工评分：{{submission.manualScore}}
        </view>
        <view wx:if="{{submission.teacherComment}}" class="feedback-comment">{{submission.teacherComment}}</view>
      </view>
    </view>

    <!-- OCR Text -->
    <view wx:if="{{submission.ocrText}}" class="result-section fade-in">
      <view class="section-header">
        <text class="section-icon">📄</text>
        <text class="section-title">OCR 文本</text>
      </view>
      <view class="ocr-card">{{submission.ocrText}}</view>
    </view>
  </block>
</view>
