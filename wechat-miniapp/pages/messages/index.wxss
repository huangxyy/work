/* pages/messages/index.wxss */
@import "../../styles/components.wxss";

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 32rpx;
}

/* 头部 */
.header-hero {
  margin: -32rpx -32rpx 32rpx -32rpx;
  padding: 64rpx 32rpx 48rpx;
  background: var(--gradient-primary);
  border-radius: 0 0 48rpx 48rpx;
  color: #ffffff;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 筛选区 */
.filter-section {
  padding: 0 8rpx 24rpx;
}

.filter-chips {
  display: flex;
  gap: 16rpx;
}

.filter-chip {
  padding: 16rpx 32rpx;
  border-radius: var(--border-radius-pill);
  font-size: 26rpx;
  white-space: nowrap;
  background: #ffffff;
  color: var(--text-secondary);
  box-shadow: var(--shadow-soft);
}

.filter-chip.active {
  background: var(--gradient-primary);
  color: #ffffff;
}

/* 错误状态 */
.error-state {
  padding: 80rpx 32rpx;
  text-align: center;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.error-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.error-text {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 24rpx;
}

/* 加载状态 */
.loading-container {
  padding: 80rpx 0;
  text-align: center;
}

.loading-text {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 消息列表 */
.message-list {
  padding: 0 8rpx;
}

.mark-read-section {
  padding: 0 24rpx 16rpx;
  display: flex;
  justify-content: flex-end;
}

.message-card {
  display: flex;
  align-items: flex-start;
  background: #ffffff;
  border-radius: var(--border-radius-large);
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
  position: relative;
}

.message-card.unread {
  background: linear-gradient(135deg, #fff9f0 0%, #ffffff 100%);
  border-left: 6rpx solid var(--secondary-orange);
}

.message-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.message-type-badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  background: #dbeafe;
  color: #2563eb;
}

.message-type-badge.announcement {
  background: #fef3c7;
  color: #92400e;
}

.message-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.message-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.message-author {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

/* 未读红点 */
.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background: var(--secondary-pink);
  border-radius: 50%;
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  flex-shrink: 0;
}

/* 置顶标签 */
.pinned-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 4rpx 12rpx;
  background: #fee2e2;
  color: #dc2626;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 600;
}

/* 空状态 */
.empty-state {
  padding: 120rpx 32rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: 24rpx;
  color: var(--text-muted);
  line-height: 1.6;
}
