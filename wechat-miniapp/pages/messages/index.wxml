<view class="container safe-bottom">
  <view class="hero-card">
    <view class="title">消息中心</view>
    <view class="subtitle">通知 {{notifications.length}} 条 · 未读 {{unreadCount}} 条 · 公告 {{announcements.length}} 条</view>
  </view>

  <view class="card section-gap">
    <view class="msg-tab-row">
      <view class="msg-tab {{tab === 'notifications' ? 'msg-tab-active' : ''}}" data-tab="notifications" bindtap="switchTab">通知</view>
      <view class="msg-tab {{tab === 'announcements' ? 'msg-tab-active' : ''}}" data-tab="announcements" bindtap="switchTab">公告</view>
    </view>
  </view>

  <view wx:if="{{errorText}}" class="card section-gap">
    <view class="error-state">
      <view class="error-title">加载失败</view>
      <view class="helper-text">{{errorText}}</view>
      <view class="action-row section-gap">
        <button class="secondary-button" bindtap="retryLoad">重新加载</button>
      </view>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="card section-gap">
    <view class="empty-state">
      <view class="empty-title">正在加载消息</view>
      <view class="helper-text">请稍候。</view>
    </view>
  </view>

  <block wx:elif="{{tab === 'notifications'}}">
    <view wx:if="{{unreadCount > 0}}" class="card section-gap">
      <view class="row-between">
        <view class="section-title">{{unreadCount}} 条未读</view>
        <button class="ghost-button msg-mark-all-btn" loading="{{markingAll}}" bindtap="handleMarkAllRead">全部已读</button>
      </view>
    </view>

    <view wx:if="{{notifications.length}}" class="list-stack section-gap">
      <view wx:for="{{notifications}}" wx:key="id" class="card msg-item {{item.isRead ? 'msg-item-read' : ''}}" data-id="{{item.id}}" bindtap="handleRead">
        <view class="row-between">
          <view class="msg-type-badge">{{item.typeLabel}}</view>
          <view class="muted small">{{item.timeLabel}}</view>
        </view>
        <view class="msg-title">{{item.title}}</view>
        <view wx:if="{{item.body}}" class="helper-text msg-body">{{item.body}}</view>
        <view wx:if="{{!item.isRead}}" class="msg-unread-dot"></view>
      </view>
    </view>

    <view wx:else class="card section-gap">
      <view class="empty-state">
        <view class="empty-title">暂无通知</view>
        <view class="helper-text">当有新作业、批改完成或教师反馈时，这里会收到通知。</view>
      </view>
    </view>
  </block>

  <block wx:elif="{{tab === 'announcements'}}">
    <view wx:if="{{announcements.length}}" class="list-stack section-gap">
      <view wx:for="{{announcements}}" wx:key="id" class="card msg-item">
        <view class="row-between">
          <view class="msg-type-badge msg-type-announcement">{{item.className}}</view>
          <view class="muted small">{{item.timeLabel}}</view>
        </view>
        <view class="msg-title">{{item.title}}</view>
        <view wx:if="{{item.content}}" class="helper-text msg-body">{{item.content}}</view>
        <view class="muted small msg-author">发布者：{{item.authorName}}</view>
        <view wx:if="{{item.pinned}}" class="msg-pinned-badge">置顶</view>
      </view>
    </view>

    <view wx:else class="card section-gap">
      <view class="empty-state">
        <view class="empty-title">暂无公告</view>
        <view class="helper-text">老师发布班级公告后，这里会展示。</view>
      </view>
    </view>
  </block>
</view>
