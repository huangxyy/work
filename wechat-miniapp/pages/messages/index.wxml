<!-- pages/messages/index.wxml -->
<view class="page theme-messages">
  <!-- 顶部标题区 -->
  <view class="header-hero scale-in">
    <view class="header-title">消息中心</view>
    <view class="header-subtitle">通知 {{notifications.length}} 条 · 未读 {{unreadCount}} 条</view>
  </view>

  <!-- 筛选标签 -->
  <view class="filter-section fade-in">
    <scroll-view class="filter-chips" scroll-x enable-flex>
      <view class="filter-chip {{tab === 'notifications' ? 'active' : ''}}" bindtap="switchTab" data-tab="notifications">通知</view>
      <view class="filter-chip {{tab === 'announcements' ? 'active' : ''}}" bindtap="switchTab" data-tab="announcements">公告</view>
    </scroll-view>
  </view>

  <!-- 错误状态 -->
  <view wx:if="{{errorText}}" class="error-state">
    <view class="error-icon">⚠️</view>
    <view class="error-title">加载失败</view>
    <view class="error-text">{{errorText}}</view>
    <button class="btn-secondary" bindtap="retryLoad">重新加载</button>
  </view>

  <!-- 加载状态 -->
  <view wx:elif="{{loading}}" class="loading-container">
    <view class="spinner"></view>
    <view class="loading-text">加载中...</view>
  </view>

  <!-- 消息列表 -->
  <view wx:else class="message-list">

    <!-- 全部已读按钮 -->
    <view wx:if="{{tab === 'notifications' && unreadCount > 0}}" class="mark-read-section">
      <button class="btn-secondary small" loading="{{markingAll}}" bindtap="handleMarkAllRead">全部标记已读</button>
    </view>

    <!-- 通知列表 -->
    <block wx:if="{{tab === 'notifications'}}">
      <view wx:if="{{notifications.length === 0}}" class="empty-state">
        <view class="empty-icon">🔔</view>
        <view class="empty-title">暂无通知</view>
        <view class="empty-text">当有新作业、批改完成或教师反馈时，这里会收到通知</view>
      </view>

      <view wx:else>
        <view wx:for="{{notifications}}" wx:key="id" class="message-card fade-in {{!item.isRead ? 'unread' : ''}}" bindtap="handleRead" data-id="{{item.id}}">
          <view class="message-icon">{{item.icon || '📬'}}</view>
          <view class="message-content">
            <view class="message-header">
              <view class="message-type-badge">{{item.typeLabel}}</view>
              <view class="message-time">{{item.timeLabel}}</view>
            </view>
            <view class="message-title">{{item.title}}</view>
            <view wx:if="{{item.body}}" class="message-text">{{item.body}}</view>
          </view>
          <view wx:if="{{!item.isRead}}" class="unread-dot"></view>
        </view>
      </view>
    </block>

    <!-- 公告列表 -->
    <block wx:elif="{{tab === 'announcements'}}">
      <view wx:if="{{announcements.length === 0}}" class="empty-state">
        <view class="empty-icon">📢</view>
        <view class="empty-title">暂无公告</view>
        <view class="empty-text">老师发布班级公告后，这里会展示</view>
      </view>

      <view wx:else>
        <view wx:for="{{announcements}}" wx:key="id" class="message-card fade-in">
          <view class="message-icon">{{item.pinned ? '📌' : '📢'}}</view>
          <view class="message-content">
            <view class="message-header">
              <view class="message-type-badge announcement">{{item.className}}</view>
              <view class="message-time">{{item.timeLabel}}</view>
            </view>
            <view class="message-title">{{item.title}}</view>
            <view wx:if="{{item.content}}" class="message-text">{{item.content}}</view>
            <view class="message-author">发布者：{{item.authorName}}</view>
          </view>
          <view wx:if="{{item.pinned}}" class="pinned-badge">置顶</view>
        </view>
      </view>
    </block>
  </view>
</view>
