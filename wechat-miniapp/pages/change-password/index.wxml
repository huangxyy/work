<view class="page safe-bottom">
  <view class="hero fade-in">
    <view class="hero-title">🔒 修改密码</view>
    <view class="hero-subtitle">定期修改密码保护账号安全</view>
  </view>

  <view class="content-area scale-in">
    <view class="form-card">
      <view class="form-item">
        <view class="form-label">当前密码</view>
        <input
          class="form-input"
          password
          placeholder="请输入当前密码"
          value="{{oldPassword}}"
          bindinput="onOldPasswordInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">新密码</view>
        <input
          class="form-input"
          password
          placeholder="至少8位，包含字母和数字"
          value="{{newPassword}}"
          bindinput="onNewPasswordInput"
        />
      </view>

      <view class="form-item">
        <view class="form-label">确认新密码</view>
        <input
          class="form-input"
          password
          placeholder="请再次输入新密码"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
      </view>
    </view>

    <view class="tips-card">
      <view class="tips-title">密码要求</view>
      <view class="tips-list">
        <view class="tip-item">• 至少8个字符</view>
        <view class="tip-item">• 包含字母和数字</view>
        <view class="tip-item">• 新旧密码不能相同</view>
      </view>
    </view>

    <button class="submit-btn" bindtap="onChangePassword" disabled="{{loading}}">
      {{loading ? '修改中...' : '确认修改'}}
    </button>
  </view>
</view>
