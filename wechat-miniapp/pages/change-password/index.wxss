.change-password-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 32rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.form-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 32rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.tips {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
}

.tip-title {
  display: block;
  font-size: 26rpx;
  color: #0891b2;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.tip-item {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.8;
}

.button-group {
  margin-top: 32rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.6;
}
