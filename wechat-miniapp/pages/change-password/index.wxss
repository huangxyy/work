@import "../../styles/components.wxss";

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 0 0 120rpx 0;
}

.hero {
  margin: 0 0 24rpx 0;
  padding: 64rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  border-radius: 0 0 48rpx 48rpx;
  color: #ffffff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.content-area {
  padding: 0 24rpx;
}

.form-card {
  background: #ffffff;
  border-radius: var(--border-radius-large);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: var(--border-radius-medium);
  font-size: 28rpx;
  color: var(--text-primary);
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.form-input:focus {
  background: #ffffff;
  border-color: #10b981;
}

.tips-card {
  background: #f0fdf4;
  border-radius: var(--border-radius-medium);
  padding: 24rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid #bbf7d0;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #166534;
  margin-bottom: 12rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tip-item {
  font-size: 24rpx;
  color: #15803d;
  line-height: 1.6;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
  border-radius: var(--border-radius-pill);
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
}

.submit-btn-disabled {
  opacity: 0.6;
  box-shadow: none;
}

.submit-btn::after {
  border: none;
}
