.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
  min-height: 400rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.8;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 12rpx;
  text-align: center;
}

.empty-description {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 32rpx;
  text-align: center;
  line-height: 1.6;
  max-width: 500rpx;
}

.empty-button {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #6366f1 100%);
  color: #ffffff;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.3);
  transition: all 0.2s;
}

.empty-button:active {
  transform: scale(0.98);
  opacity: 0.9;
}
