var getHomeworkStatusText = function(status) {
  var map = {
    'DRAFT': '草稿',
    'PUBLISHED': '已发布',
    'CLOSED': '已关闭',
  };
  return map[status] || status;
};

var formatDate = function(dateStr) {
  if (!dateStr) return '--';
  var date = getDate(dateStr);
  var year = date.getFullYear();
  var month = date.getMonth() + 1;
  var day = date.getDate();
  if (month < 10) month = '0' + month;
  if (day < 10) day = '0' + day;
  return year + '-' + month + '-' + day;
};

var formatDateTime = function(dateStr) {
  if (!dateStr) return '--';
  var date = getDate(dateStr);
  var year = date.getFullYear();
  var month = date.getMonth() + 1;
  var day = date.getDate();
  var hour = date.getHours();
  var minute = date.getMinutes();
  if (month < 10) month = '0' + month;
  if (day < 10) day = '0' + day;
  if (hour < 10) hour = '0' + hour;
  if (minute < 10) minute = '0' + minute;
  return year + '-' + month + '-' + day + ' ' + hour + ':' + minute;
};

var getSubmissionStatusText = function(status) {
  var map = {
    'QUEUED': '排队中',
    'PROCESSING': '处理中',
    'DONE': '已完成',
    'FAILED': '失败',
  };
  return map[status] || status;
};

var getSkipReasonText = function(reason) {
  var map = {
    'NON_IMAGE': '非图片文件',
    'ACCOUNT_NOT_FOUND': '账号不存在',
    'STUDENT_NOT_FOUND': '学生不存在',
    'OCR_EMPTY': '无法识别文字',
    'OCR_FAILED': 'OCR识别失败',
    'AI_NO_MATCH': '无法匹配学生',
    'AI_AMBIGUOUS': '匹配结果不明确',
    'AI_PARSE_FAILED': 'AI解析失败',
    'AI_NOT_CONFIGURED': 'AI未配置',
    'AI_FAILED': 'AI处理失败',
  };
  return map[reason] || reason;
};

var toFixed = function(num, digits) {
  if (!num && num !== 0) return '--';
  digits = digits || 2;
  return num.toFixed(digits);
};

var getFirstChar = function(str, fallback) {
  fallback = fallback || '?';
  if (!str) return fallback;
  return str.charAt(0);
};

var isHomeworkOpen = function(dueAt) {
  if (!dueAt) return false;
  var due = getDate(dueAt);
  var now = getDate();
  return due > now;
};

var getHomeworkStatusClass = function(dueAt, allowLateSubmission) {
  if (!dueAt) return 'status-ongoing';
  var due = getDate(dueAt);
  var now = getDate();
  if (due > now) return 'status-ongoing';
  if (allowLateSubmission) return 'status-late';
  return 'status-expired';
};

var getHomeworkStatusLabelText = function(dueAt, allowLateSubmission) {
  if (!dueAt) return '进行中';
  var due = getDate(dueAt);
  var now = getDate();
  if (due > now) return '进行中';
  if (allowLateSubmission) return '逾期可补交';
  return '已截止';
};

var getHomeworkStatusMeta = function(dueAt, allowLateSubmission) {
  if (!dueAt) {
    return { key: 'ongoing', label: '进行中', className: 'status-ongoing' };
  }
  var due = getDate(dueAt);
  var now = getDate();
  if (due > now) {
    return { key: 'ongoing', label: '进行中', className: 'status-ongoing' };
  }
  if (allowLateSubmission) {
    return { key: 'late', label: '逾期可补交', className: 'status-late' };
  }
  return { key: 'expired', label: '已截止', className: 'status-expired' };
};

var max = function(a, b) {
  a = a || 0;
  b = b || 0;
  return a > b ? a : b;
};

var min = function(a, b) {
  a = a || 0;
  b = b || 0;
  return a < b ? a : b;
};

var clamp = function(value, minVal, maxVal) {
  value = value || 0;
  minVal = minVal || 0;
  maxVal = maxVal || 0;
  if (value < minVal) return minVal;
  if (value > maxVal) return maxVal;
  return value;
};

var round = function(value) {
  value = value || 0;
  return Math.round(value);
};

var calcPercent = function(numerator, denominator) {
  numerator = numerator || 0;
  denominator = denominator || 1;
  if (denominator <= 0) return 0;
  var percent = (numerator / denominator) * 100;
  if (percent > 100) percent = 100;
  if (percent < 0) percent = 0;
  return Math.round(percent);
};

module.exports = {
  getHomeworkStatusText: getHomeworkStatusText,
  formatDate: formatDate,
  formatDateTime: formatDateTime,
  getSubmissionStatusText: getSubmissionStatusText,
  getSkipReasonText: getSkipReasonText,
  toFixed: toFixed,
  getFirstChar: getFirstChar,
  isHomeworkOpen: isHomeworkOpen,
  getHomeworkStatusClass: getHomeworkStatusClass,
  getHomeworkStatusLabelText: getHomeworkStatusLabelText,
  getHomeworkStatusMeta: getHomeworkStatusMeta,
  max: max,
  min: min,
  clamp: clamp,
  round: round,
  calcPercent: calcPercent,
};
