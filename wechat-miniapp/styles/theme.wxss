/* styles/theme.wxss */
page {
  --primary-green: #10b981;
  --secondary-green: #059669;
  --primary-orange: #f59e0b;
  --secondary-orange: #fb923c;
  --primary-teal: #14b8a6;
  --secondary-teal: #0d9488;
  --primary-red: #ef4444;
  --secondary-red: #f97316;
  --primary-amber: #fbbf24;
  --secondary-amber: #f59e0b;
  --primary-lime: #84cc16;
  --secondary-lime: #65a30d;

  --text-primary: #333333;
  --text-secondary: #666666;
  --text-muted: #999999;
  --bg-page: #f5f5f5;
  --bg-card: #ffffff;

  --border-radius-large: 32rpx;
  --border-radius-medium: 24rpx;
  --border-radius-small: 16rpx;
  --border-radius-pill: 999rpx;

  --shadow-soft: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  --shadow-card: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

/* 页面主题色 - 作业列表 (绿色) */
.theme-homeworks {
  --gradient-primary: linear-gradient(135deg, var(--primary-green) 0%, var(--secondary-green) 100%);
  --color-primary: var(--primary-green);
}

/* 页面主题色 - 提交作业 (橙色) */
.theme-submit {
  --gradient-primary: linear-gradient(135deg, var(--primary-orange) 0%, var(--secondary-orange) 100%);
  --color-primary: var(--primary-orange);
}

/* 页面主题色 - 批改结果 (红橙渐变) */
.theme-result {
  --gradient-primary: linear-gradient(135deg, var(--primary-red) 0%, var(--secondary-red) 100%);
  --color-primary: var(--primary-red);
}

/* 页面主题色 - 个人中心 (青绿渐变) */
.theme-profile {
  --gradient-primary: linear-gradient(135deg, var(--primary-teal) 0%, var(--secondary-teal) 100%);
  --color-primary: var(--primary-teal);
}

/* 页面主题色 - 消息通知 (红橙渐变) */
.theme-messages {
  --gradient-primary: linear-gradient(135deg, var(--primary-red) 0%, var(--secondary-red) 100%);
  --color-primary: var(--primary-red);
}

/* 页面主题色 - 学习报告 (橙黄渐变) */
.theme-report {
  --gradient-primary: linear-gradient(135deg, var(--primary-amber) 0%, var(--secondary-amber) 100%);
  --color-primary: var(--primary-amber);
}

/* 页面主题色 - 登录页 (绿色渐变) */
.theme-login {
  --gradient-primary: linear-gradient(135deg, var(--primary-green) 0%, var(--secondary-green) 100%);
  --color-primary: var(--primary-green);
}

/* ===== Teacher Page Themes ===== */

/* 页面主题色 - 老师仪表盘 (橙色渐变) */
.theme-dashboard {
  --gradient-primary: linear-gradient(135deg, #f59e0b 0%, #fb923c 100%);
  --color-primary: #f59e0b;
}

/* 页面主题色 - 老师作业 (橙色) */
.theme-teacher-homeworks {
  --gradient-primary: linear-gradient(135deg, #f59e0b 0%, #fb923c 100%);
  --color-primary: #f59e0b;
}

/* 页面主题色 - 老师班级 (青绿渐变) */
.theme-teacher-classes {
  --gradient-primary: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
  --color-primary: #14b8a6;
}

/* 页面主题色 - 老师提交详情 (橙色) */
.theme-teacher-submission {
  --gradient-primary: linear-gradient(135deg, #f59e0b 0%, #fb923c 100%);
  --color-primary: #f59e0b;
}

/* 页面主题色 - 老师公告 (红橙渐变) */
.theme-teacher-announcements {
  --gradient-primary: linear-gradient(135deg, #ef4444 0%, #f97316 100%);
  --color-primary: #ef4444;
}

/* 页面主题色 - 老师评分设置 (绿色) */
.theme-teacher-grading {
  --gradient-primary: linear-gradient(135deg, #10b981 0%, #059669 100%);
  --color-primary: #10b981;
}
