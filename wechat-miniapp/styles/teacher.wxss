/* styles/teacher.wxss - 老师端特定样式扩展 */
/* 此文件只包含老师端独有的样式，通用样式请使用 theme.wxss 和 components.wxss */

/* ===== 老师端页面主题扩展 ===== */
/* 复用学生端彩虹世界主题，每个老师端页面指定主题色 */

/* 老师端默认变量 (覆盖 theme.wxss 中相同的变量) */
page {
  --teacher-primary: #f59e0b;
  --teacher-primary-dark: #d97706;
  --teacher-secondary: #fb923c;
  --teacher-green: #10b981;
  --teacher-orange: #f59e0b;
  --teacher-red: #dc2626;
  --teacher-teal: #14b8a6;

  /* 文本颜色 */
  --text-primary: #1f2937;
  --text-secondary: #4b5563;
  --text-muted: #6b7280;

  /* 背景色 */
  --bg-page: #f3f4f6;
  --bg-card: #ffffff;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

/* ===== 页面基础布局 ===== */
.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: 32rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.page-safe {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom) + 32rpx);
}

/* ===== 英雄区域 (Hero Section) ===== */
.hero {
  margin: -32rpx -32rpx 24rpx -32rpx;
  padding: 64rpx 32rpx 48rpx;
  background: var(--gradient-primary, linear-gradient(135deg, #f59e0b 0%, #fb923c 100%));
  border-radius: 0 0 48rpx 48rpx;
  color: #ffffff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.hero-stats {
  display: flex;
  gap: 32rpx;
  margin-top: 24rpx;
}

.hero-stat {
  text-align: center;
}

.hero-stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.hero-stat-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

/* ===== 渐变背景类 ===== */
.gradient-primary {
  background: linear-gradient(135deg, #f59e0b 0%, #fb923c 100%);
}

.gradient-green {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.gradient-orange {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

.gradient-teal {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
}

.gradient-red {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
}

/* ===== 卡片样式 ===== */
.card {
  background: var(--bg-card);
  border-radius: var(--border-radius-medium, 24rpx);
  padding: 28rpx;
  margin: 16rpx;
  box-shadow: var(--shadow-md);
}

.card-compact {
  padding: 20rpx;
  margin: 12rpx 16rpx;
}

.card-hero {
  background: var(--gradient-primary, linear-gradient(135deg, #f59e0b 0%, #fb923c 100%));
  color: #ffffff;
  border-radius: var(--border-radius-medium, 24rpx);
  padding: 32rpx;
  margin: 16rpx;
  box-shadow: var(--shadow-lg);
}

/* ===== 列表项 ===== */
.list-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background 0.2s;
}

.list-item:last-child {
  border-bottom: none;
}

.list-item:active {
  background: #f8fafc;
}

/* ===== 按钮样式 ===== */
.btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 48rpx;
  border-radius: 44rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.2s;
}

.btn-primary {
  background: var(--gradient-primary, linear-gradient(135deg, #f59e0b 0%, #fb923c 100%));
  color: #ffffff;
  box-shadow: var(--shadow-md);
}

.btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-secondary {
  background: #ffffff;
  color: #f59e0b;
  border: 4rpx solid #f59e0b;
}

.btn-ghost {
  background: transparent;
  color: var(--text-secondary);
}

.btn-danger {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  color: #ffffff;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ===== 悬浮按钮 ===== */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  background: var(--gradient-primary, linear-gradient(135deg, #f59e0b 0%, #fb923c 100%));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.4);
  z-index: 100;
  transition: transform 0.2s;
}

.fab:active {
  transform: scale(0.95);
}

/* ===== 图片网格 ===== */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 16rpx;
}

.photo-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--border-radius-small, 16rpx);
  overflow: hidden;
  background: #f5f5f5;
}

.photo-item image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo-item .remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  z-index: 1;
}

.photo-item.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #9ca3af;
  border: 4rpx dashed #d1d5db;
  background: #f9fafb;
}

/* ===== 匹配结果卡片 ===== */
.match-result-card {
  background: #ffffff;
  border-radius: var(--border-radius-small, 16rpx);
  padding: 24rpx;
  margin: 16rpx;
}

.match-result-card.matched {
  border-left: 6rpx solid #10b981;
}

.match-result-card.unmatched {
  border-left: 6rpx solid #f59e0b;
}

.match-result-card.skipped {
  border-left: 6rpx solid #ef4444;
}

/* ===== 选择器行 ===== */
.selector-row {
  background: #ffffff;
  border-radius: var(--border-radius-small, 16rpx);
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.selector-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.selector-value {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.selector-arrow {
  font-size: 32rpx;
  color: var(--text-muted);
}

.selector-value.mode-cheap {
  color: var(--teacher-green);
}

.selector-value.mode-quality {
  color: var(--teacher-orange);
}

/* ===== 底部弹出选择器 ===== */
.selector-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.selector-content {
  width: 100%;
  max-height: 60vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.selector-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  text-align: center;
  color: var(--text-primary);
}

.selector-list {
  max-height: 35vh;
}

.selector-option {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background 0.2s;
}

.selector-option:last-child {
  border-bottom: none;
}

.selector-option:active {
  background: #f8fafc;
}

.selector-option.active .selector-option-name {
  color: var(--teacher-primary);
}

.selector-option-name {
  display: block;
  font-size: 30rpx;
  margin-bottom: 8rpx;
  color: var(--text-primary);
}

.selector-option-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ===== 统计卡片 ===== */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 0 16rpx;
}

.stat-card {
  flex: 1;
  background: var(--gradient-primary, linear-gradient(135deg, #f59e0b 0%, #fb923c 100%));
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  color: #ffffff;
  min-height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.04);
}

.stat-card.green {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
}

.stat-card.orange {
  background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
}

.stat-card.teal {
  background: linear-gradient(135deg, #14b8a6 0%, #0d9488 100%);
}

.stat-card.red {
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
}

.stat-card-clickable {
  position: relative;
  box-shadow: var(--shadow-md);
  transition: all 0.2s;
  cursor: pointer;
  overflow: visible;
  z-index: 1;
}

.stat-card-clickable:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.stat-card-clickable::after {
  content: '›';
  position: absolute;
  right: 16rpx;
  bottom: 12rpx;
  font-size: 40rpx;
  opacity: 0.7;
  font-weight: bold;
  pointer-events: none;
}

.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
}

/* ===== 区块样式 ===== */
.section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 16rpx 16rpx;
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  font-weight: 600;
}

/* ===== 表单样式 ===== */
.form-section {
  padding: 16rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.form-label .required {
  color: #ef4444;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx;
  border-radius: var(--border-radius-small, 16rpx);
  background: #f8fafc;
  border: 4rpx solid transparent;
  font-size: 28rpx;
  color: var(--text-primary);
  transition: all 0.2s;
}

.form-input:focus {
  background: #ffffff;
  border-color: var(--teacher-primary);
  box-shadow: 0 0 0 4rpx rgba(245, 158, 11, 0.1);
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  border-radius: var(--border-radius-small, 16rpx);
  background: #f8fafc;
  border: 4rpx solid transparent;
  font-size: 28rpx;
  color: var(--text-primary);
  transition: all 0.2s;
}

.form-textarea:focus {
  background: #ffffff;
  border-color: var(--teacher-primary);
}

.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-radius: var(--border-radius-small, 16rpx);
  background: #f8fafc;
}

.form-picker-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

.form-picker-arrow {
  font-size: 24rpx;
  color: var(--text-muted);
}

.form-hint {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  text-align: right;
}

/* ===== 用户卡片 ===== */
.user-card {
  background: var(--gradient-primary, linear-gradient(135deg, #10b981 0%, #059669 100%));
  border-radius: var(--border-radius-medium, 24rpx);
  padding: 48rpx 32rpx;
  display: flex;
  align-items: center;
  margin: 16rpx;
  box-shadow: var(--shadow-lg);
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.user-avatar-text {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 700;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  color: #ffffff;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.user-account {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* ===== 菜单列表 ===== */
.menu-list {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 0 16rpx 16rpx;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f8fafc;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
}

.menu-arrow {
  font-size: 32rpx;
  color: #d1d5db;
}

/* ===== 按钮组 ===== */
.button-group {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 16rpx;
}

.button-group .btn {
  flex: 1;
}

/* ===== 加载、空状态、错误状态 ===== */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: var(--teacher-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--text-muted);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
  text-align: center;
}

.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.error-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.error-text {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 32rpx;
  text-align: center;
}

/* ===== 作业卡片 ===== */
.homework-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 16rpx 16rpx;
  box-shadow: var(--shadow-md);
  transition: transform 0.2s;
}

.homework-card:active {
  transform: scale(0.98);
}

.homework-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.homework-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  padding-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.homework-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 12rpx;
}

.homework-meta-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--text-muted);
}

.homework-meta-icon {
  margin-right: 6rpx;
  font-size: 24rpx;
}

.homework-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.homework-action-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  border: none;
}

.homework-action-btn.primary {
  background: var(--gradient-primary, linear-gradient(135deg, #f59e0b 0%, #fb923c 100%));
  color: #ffffff;
}

.homework-action-btn.ghost {
  background: #f8fafc;
  color: var(--text-secondary);
}

.homework-action-btn.danger {
  background: #fef2f2;
  color: #ef4444;
}

/* ===== 作业进度条 ===== */
.homework-progress {
  margin-top: 16rpx;
}

.homework-progress-bar {
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
}

.homework-progress-fill {
  height: 100%;
  background: var(--gradient-primary, linear-gradient(90deg, var(--teacher-primary) 0%, var(--teacher-secondary) 100%));
  border-radius: 4rpx;
  transition: width 0.3s;
}

.homework-progress-text {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  text-align: right;
}

/* ===== 提交卡片 ===== */
.submission-card {
  background: #ffffff;
  border-radius: var(--border-radius-small, 16rpx);
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-shadow: var(--shadow-sm);
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: transform 0.2s;
}

.submission-card:active {
  transform: scale(0.98);
}

.submission-info {
  flex: 1;
}

.submission-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

.submission-score {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* ===== 评分详情 ===== */
.grading-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 16rpx 16rpx;
  box-shadow: var(--shadow-sm);
}

.grading-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.grading-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.grading-row:last-child {
  border-bottom: none;
}

.grading-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.grading-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #f59e0b;
  word-break: break-all;
  overflow-wrap: break-word;
  max-width: 100%;
}

.grading-comment {
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

.grading-comment-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* ===== 状态扩展 ===== */
.status-tag.PUBLISHED {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  color: #ffffff;
}

.status-tag.DRAFT {
  background: #f3f4f6;
  color: #6b7280;
}

.status-tag.CLOSED {
  background: #e5e7eb;
  color: #9ca3af;
}

/* ===== 可点击元素统一样式 ===== */
.clickable-item {
  position: relative;
  transition: all 0.2s;
}

.clickable-item:active {
  background: #f8fafc;
}

.clickable-item::after {
  content: '›';
  position: absolute;
