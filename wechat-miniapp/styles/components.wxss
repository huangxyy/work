/* styles/components.wxss - 通用组件样式 */

/* ===== 可点击元素通用样式 ===== */
.clickable {
  position: relative;
  cursor: pointer;
  transition: all 0.2s;
}

.clickable:active {
  opacity: 0.7;
  transform: scale(0.98);
}

.clickable-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  transition: background 0.2s;
  cursor: pointer;
  overflow: visible;
  z-index: 1;
}

.clickable-item:active {
  background: #f8fafc;
}

.clickable-item::after {
  content: '';
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #d1d5db;
  border-right: 3rpx solid #d1d5db;
  transform: translateY(-50%) rotate(45deg);
  pointer-events: none;
}

.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ===== 渐变按钮 ===== */
.btn-gradient {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 48rpx;
  border-radius: var(--border-radius-pill, 999rpx);
  border: none;
  background: var(--gradient-primary);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: var(--shadow-soft);
  transition: all 0.2s;
}

.btn-gradient-disabled {
  opacity: 0.5;
}

.btn-gradient:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* ===== 次要按钮 ===== */
.btn-secondary {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 40rpx;
  border-radius: var(--border-radius-pill, 999rpx);
  background: #ffffff;
  color: var(--color-primary, #0891b2);
  border: 4rpx solid var(--color-primary, #0891b2);
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s;
}

.btn-secondary:active {
  transform: scale(0.98);
  background: #f8fafc;
}

/* ===== 状态标签 ===== */
.status-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: var(--border-radius-pill, 999rpx);
  font-size: 22rpx;
  font-weight: 500;
}

.status-tag.progress {
  background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);
  color: #ffffff;
}

.status-tag.done {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  color: #ffffff;
}

.status-tag.late {
  background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);
  color: #ffffff;
}

.status-tag.expired {
  background: #e0e0e0;
  color: #999999;
}

.status-tag.urgent {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #ffffff;
}

/* ===== 彩虹卡片 ===== */
.rainbow-card {
  background: #ffffff;
  border-radius: var(--border-radius-large, 32rpx);
  padding: 32rpx;
  box-shadow: var(--shadow-card);
}

.rainbow-card-hero {
  background: var(--gradient-primary);
  color: #ffffff;
  border-radius: var(--border-radius-large, 32rpx);
  padding: 48rpx 32rpx;
  box-shadow: var(--shadow-card);
}

/* ===== 筛选胶囊 ===== */
.filter-chips {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 8rpx 0;
}

.filter-chips::-webkit-scrollbar {
  display: none;
}

.filter-chip {
  padding: 16rpx 32rpx;
  border-radius: var(--border-radius-pill, 999rpx);
  font-size: 26rpx;
  white-space: nowrap;
  background: #ffffff;
  color: var(--text-secondary);
  transition: all 0.2s;
}

.filter-chip:active {
  transform: scale(0.95);
}

.filter-chip.active {
  background: var(--gradient-primary);
  color: #ffffff;
}

/* ===== 图片上传区 ===== */
.upload-area {
  background: #ffffff;
  border-radius: var(--border-radius-large, 32rpx);
  padding: 48rpx 32rpx;
  text-align: center;
  border: 4rpx dashed var(--color-primary);
}

.upload-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.upload-hint {
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.upload-subhint {
  color: var(--text-muted);
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* ===== 图片预览网格 ===== */
.image-preview-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.image-preview-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--border-radius-medium, 24rpx);
  background: #f0f0f0;
  position: relative;
}

.image-preview-add {
  background: var(--gradient-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 48rpx;
}

/* ===== 输入框组件 ===== */
.rainbow-input {
  min-height: 88rpx;
  width: 100%;
  padding: 24rpx 32rpx;
  border-radius: var(--border-radius-medium, 24rpx);
  background: #f5f5f5;
  border: none;
  font-size: 28rpx;
  color: var(--text-primary);
  transition: all 0.2s;
}

.rainbow-input.focused {
  background: #ffffff;
  border: 4rpx solid var(--color-primary);
}

/* ===== 老师端筛选胶囊 ===== */
.teacher-filter-section {
  margin: 0 24rpx 24rpx;
}

.teacher-filter-chips {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding: 8rpx 0;
}

.teacher-filter-chips::-webkit-scrollbar {
  display: none;
}

.teacher-filter-chip {
  padding: 20rpx 40rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
  background: #ffffff;
  color: var(--teacher-text-secondary, #4b5563);
  border: 2rpx solid #e5e7eb;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.teacher-filter-chip:active {
  transform: scale(0.95);
  background: #f3f4f6;
}

.teacher-filter-chip.active {
  background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);
  color: #ffffff;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(8, 145, 178, 0.3);
}

/* ===== 老师端加载状态 ===== */
.teacher-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.teacher-loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #e5e7eb;
  border-top-color: #0891b2;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.teacher-loading-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--teacher-text-muted, #9ca3af);
}

/* ===== 老师端空状态 ===== */
.teacher-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.teacher-empty-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.teacher-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--teacher-text-primary, #1f2937);
  margin-bottom: 8rpx;
}

.teacher-empty-text {
  font-size: 26rpx;
  color: var(--teacher-text-muted, #9ca3af);
  margin-bottom: 32rpx;
}

/* ===== 老师端错误状态 ===== */
.teacher-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.teacher-error-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.teacher-error-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--teacher-text-primary, #1f2937);
  margin-bottom: 8rpx;
}

.teacher-error-text {
  font-size: 26rpx;
  color: var(--teacher-text-muted, #9ca3af);
  margin-bottom: 32rpx;
  text-align: center;
}

.teacher-error-retry {
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: all 0.2s;
}

.teacher-error-retry:active {
  transform: scale(0.98);
}

/* ===== 老师端卡片动画 ===== */
.teacher-fade-in {
  animation: teacher-fadeIn 0.4s ease-out;
}

@keyframes teacher-fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.teacher-scale-in {
  animation: teacher-scaleIn 0.3s ease-out;
}

@keyframes teacher-scaleIn {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* ===== 老师端卡片基础样式 ===== */
.teacher-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.teacher-card-compact {
  padding: 20rpx;
  margin: 12rpx 16rpx;
}

/* ===== 老师端按钮样式 ===== */
.teacher-btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 48rpx;
  border-radius: 44rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.2s;
}

.teacher-btn-primary {
  background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.teacher-btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.teacher-btn-secondary {
  background: #ffffff;
  color: #0891b2;
  border: 4rpx solid #0891b2;
}

.teacher-btn-secondary:active {
  transform: scale(0.98);
  background: #f8fafc;
}

.teacher-btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* ===== 优化后的选择器弹窗 ===== */
.selector-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
  animation: fadeIn 0.2s ease-out;
}

.selector-content {
  width: 100%;
  max-height: 60vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.15);
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.selector-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  text-align: center;
  color: var(--text-primary);
}

.selector-list {
  max-height: 35vh;
}

.selector-option {
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  transition: background 0.2s;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.selector-option:active {
  background: #f8fafc;
}

.selector-option.active {
  background: #ecfeff;
}

.selector-option.active .selector-option-name {
  color: #0891b2;
  font-weight: 600;
}

.selector-option.active::after {
  content: '✓';
  color: #0891b2;
  font-size: 32rpx;
  font-weight: 700;
}

.selector-option:last-child {
  border-bottom: none;
}

.selector-option-name {
  display: block;
  font-size: 30rpx;
  color: var(--text-primary);
}

.selector-option-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ===== 点击反馈动画 ===== */
@keyframes tapScale {
  0% { transform: scale(1); }
  50% { transform: scale(0.95); }
  100% { transform: scale(1); }
}

.tap-feedback {
  animation: tapScale 0.2s ease-out;
}
